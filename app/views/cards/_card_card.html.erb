<% card_color = card.display_color %>
<% used_limit = @card_debt_totals_by_card.fetch(card.id, 0).to_f %>
<% available_limit = card.total_limit.to_f - used_limit %>
<% selected_month_total = @card_month_totals_by_card.fetch(card.id, used_limit).to_f %>
<% selected_month_label = @month.present? && @year.present? ? "Total do mês" : "Total utilizado" %>

<article
  id="<%= dom_id(card) %>"
  class="app-card-card"
  style="--card-color: <%= card_color %>; --category-color: <%= card_color %>;"
>
  <div class="app-card-card__main">
    <div class="app-card-card__header">
      <div class="app-card-card__identity">
        <span class="app-card-card__image-wrap">
          <% if card.icon.attached? %>
            <%= image_tag card.icon, class: "app-card-card__image", alt: card.name %>
          <% else %>
            <span class="material-symbols-rounded app-card-card__fallback-icon">credit_card</span>
          <% end %>
        </span>

        <div>
          <h3><%= card.name %></h3>
          <small><%= card.number.present? ? "**** **** **** #{card.number[-4..-1]}" : "Sem número cadastrado" %></small>
        </div>
      </div>

      <div class="app-card-card__actions">
        <%= link_to edit_card_path(card),
                    class: "app-category-card__action",
                    title: "Editar cartão",
                    data: { turbo_frame: "modal" } do %>
          <span class="material-symbols-rounded">edit</span>
        <% end %>

        <%= link_to card,
                    data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                    class: "app-category-card__action app-category-card__action--danger",
                    title: "Excluir cartão" do %>
          <span class="material-symbols-rounded">delete</span>
        <% end %>
      </div>
    </div>

    <div class="app-card-card__metrics">
      <div>
        <span>Limite total</span>
        <strong><%= number_to_currency(card.total_limit || 0, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>

      <div>
        <span>Disponível</span>
        <strong><%= number_to_currency(available_limit, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>

      <div>
        <span>Utilizado</span>
        <strong><%= number_to_currency(used_limit, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>

      <div>
        <span><%= selected_month_label %></span>
        <strong><%= number_to_currency(selected_month_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
    </div>
  </div>

  <div class="app-card-card__footer">
    <div class="app-card-card__dates">
      <span>Vence dia <strong><%= card.due_day.presence || "-" %></strong></span>
      <span>Fecha dia <strong><%= card.closing_day.presence || "-" %></strong></span>
    </div>

    <%= form_with url: pay_card_path(card),
                  method: :post,
                  data: { turbo_confirm: "Deseja marcar como pagas todas as despesas e parcelas NÃO pagas deste cartão para o mês de balanço #{@pay_balance_month_label}?" },
                  class: "app-card-card__pay" do %>
      <%= hidden_field_tag :month, @month if @month.present? %>
      <%= hidden_field_tag :year, @year if @year.present? %>

      <button type="submit" class="app-btn app-btn--sm app-btn--warning">
        <span class="material-symbols-rounded">credit_card</span>
        Pagar
      </button>
    <% end %>
  </div>
</article>
