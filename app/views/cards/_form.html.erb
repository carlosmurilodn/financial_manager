<%= form_with model: card, local: true, html: { class: "app-form-page__form", data: { turbo: false } } do |f| %>
  <div class="row app-mb-3">
    <div class="col-md-6">
      <%= f.label :name, t("cards.form.name") %>
      <%= f.text_field :name, class: "app-form-control", required: true %>
    </div>

    <div class="col-md-6">
      <%= f.label :number, t("cards.form.number") %>
      <%= f.text_field :number,
            class: "app-form-control card-number",
            placeholder: "1234 5678 1234 5678",
            maxlength: 19
      %>
    </div>
  </div>

  <div class="row app-mb-3">
    <div class="col-md-3">
      <%= f.label :total_limit, "Limite Total" %>
      <%= f.text_field :total_limit,
            class: "app-form-control moeda",
            value: number_to_currency(card.total_limit || 0, unit: "R$", separator: ",", delimiter: ".")
      %>
    </div>

    <div class="col-md-3">
      <%= f.label :remaining_limit, "Limite Restante" %>
      <%= text_field_tag :remaining_limit_display,
            number_to_currency(card.remaining_limit || 0, unit: "R$", separator: ",", delimiter: "."),
            class: "app-form-control",
            readonly: true
      %>
    </div>

    <div class="col-md-3">
      <%= f.label :due_day, "Dia do Vencimento" %>
      <div class="custom-date-wrapper">
        <%= f.text_field :due_day, class: "app-form-control custom-date-day", autocomplete: "off", placeholder: "Selecione o dia" %>
      </div>
    </div>

    <div class="col-md-3">
      <%= f.label :closing_day, "Dia de Fechamento" %>
      <div class="custom-date-wrapper">
        <%= f.text_field :closing_day, class: "app-form-control custom-date-day", autocomplete: "off", placeholder: "Selecione o dia" %>
      </div>
    </div>
  </div>

  <div class="row app-mb-3">
    <div class="col-md-8">
      <%= f.label :icon, "Imagem do cartão" %>
      <%= f.file_field :icon, class: "app-form-control", accept: "image/*" %>
      <% if card.icon.attached? %>
        <div class="form-text">Imagem atual anexada: <%= card.icon.filename.to_s %></div>
      <% else %>
        <div class="form-text">Você pode anexar uma imagem para exibir no cartão.</div>
      <% end %>
    </div>

    <% if card.icon.attached? %>
      <div class="col-md-4 app-flex app-align-end">
        <div class="app-form-check">
          <%= check_box_tag "card[remove_icon]", "1", false, class: "app-form-check-input", id: "card_remove_icon" %>
          <%= label_tag "card_remove_icon", "Remover imagem atual", class: "app-form-check-label" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row app-mb-3">
    <div class="col-md-6">
      <%= f.label :color, "Cor do cartão" %>
      <% selected_color = card.color.presence || Card::COLOR_PALETTE.values.first %>

      <div class="app-color-select-field">
        <%= f.select :color,
              options_for_select(Card::COLOR_PALETTE.to_a, selected_color),
              {},
              class: "app-form-select",
              data: { color_select: true } %>

        <span class="app-color-name-badge" style="--color-select-color: <%= selected_color %>;">
          <%= Category.color_name_for(selected_color) %>
        </span>
      </div>
    </div>
  </div>

  <div class="app-form-page__actions">
    <%= link_to "Cancelar", card.persisted? ? card_path(card) : cards_path, class: "app-btn app-btn--outline" %>
    <%= f.submit t("cards.form.submit"), class: "app-btn app-btn--primary" %>
  </div>
<% end %>
