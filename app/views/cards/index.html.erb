<section class="app-page">
  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Cartões", path: cards_path }
  ] %>

  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--cards">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">credit_card</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Gestão</p>
          <h1 class="app-page__title">Cartões</h1>
          <%# <p class="app-page__description">Acompanhe limites, vencimentos e acione rapidamente o fechamento do mês.</p> %>
        </div>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>

      <div class="app-page__hero-unit">
      </div>
    </div>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: cards_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-grid app-filter-grid--cards">
          <div class="app-filter-field">
            <%= f.label :description, "Descrição" %>
            <%= f.text_field :description, value: @description_filter, class: "app-form-control", placeholder: "Buscar dívida ou cartão..." %>
          </div>

          <div class="app-filter-field">
            <%= f.label :month, "Mês" %>
            <%= f.select :month,
                  options_for_select(
                    [["Todos", 0]] + I18n.t("date.month_names")[1..12].map.with_index { |m, i| [m.capitalize, i + 1] },
                    @month || 0
                  ),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :year, "Ano" %>
            <%= f.select :year,
                  options_for_select([["Todos", 0]] + (@card_debt_years || []), @year || 0),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :has_debt, "Dívida?" %>
            <div class="app-filter-toggle-group">
              <%= link_to "Todos",
                    cards_path(request.query_parameters.except("has_debt").merge(has_debt: "")),
                    class: "app-filter-toggle-btn #{@has_debt_filter.blank? ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Com",
                    cards_path(request.query_parameters.merge(has_debt: "true")),
                    class: "app-filter-toggle-btn #{@has_debt_filter == 'true' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Sem",
                    cards_path(request.query_parameters.merge(has_debt: "false")),
                    class: "app-filter-toggle-btn #{@has_debt_filter == 'false' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
            </div>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel app-me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_cards_path,
                      class: "app-btn app-btn--secondary app-page__secondary-btn",
                      data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle app-me-1"></i> Limpar Filtros
          <% end %>

          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "cards_grid" %>
  </div>
</section>

<turbo-frame id="modal" style="display: none;"></turbo-frame>

<div id="appModal" class="app-modal" aria-hidden="true">
  <div class="app-modal__backdrop" data-modal-backdrop="true"></div>

  <div class="app-modal__dialog">
    <div class="app-modal__content">
      <div id="app-modal-body"></div>
    </div>
  </div>
</div>
