<% category_color = category.display_color %>
<% expense_total = @category_expenses_by_id&.fetch(category.id, 0) || 0 %>
<% income_total = @category_incomes_by_id&.fetch(category.id, 0) || 0 %>

<article id="<%= dom_id(category) %>" class="expense-card category-row" style="--expense-category-color: <%= category_color %>;">
  <div class="category-row__content">
    <div class="category-row__identity">
      <span class="expense-card__icon-wrapper">
        <span class="material-symbols-rounded expense-card__icon"><%= category.material_icon %></span>
      </span>

      <div class="category-row__copy">
        <h3 class="expense-card__title"><%= link_to category.display_name, category_path(category), class: "stealth-link" %></h3>
        <span class="expense-card__pill"><%= category.color_name %></span>
      </div>
    </div>

    <div class="category-row__metrics">
      <div class="resource-row-metric resource-row-metric--income">
        <span class="resource-row-metric__icon"><span class="material-symbols-rounded">trending_up</span></span>
        <span class="resource-row-metric__content">
          <span class="resource-row-metric__label">Receitas</span>
          <strong><%= number_to_currency(income_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
        </span>
      </div>
      <div class="resource-row-metric resource-row-metric--expense">
        <span class="resource-row-metric__icon"><span class="material-symbols-rounded">payments</span></span>
        <span class="resource-row-metric__content">
          <span class="resource-row-metric__label">Despesas</span>
          <strong><%= number_to_currency(expense_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
        </span>
      </div>
    </div>

    <div class="resource-row-actions category-row__actions">
      <div class="resource-row-actions__icons">
        <%= link_to edit_category_path(category), class: "expense-card__action", title: "Editar categoria",
                    aria: { label: "Editar categoria #{category.display_name}" } do %>
          <span class="material-symbols-rounded">edit</span>
        <% end %>
        <%= link_to category_path(category), data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                    class: "expense-card__action expense-card__action--danger", title: "Excluir categoria",
                    aria: { label: "Excluir categoria #{category.display_name}" } do %>
          <span class="material-symbols-rounded">delete</span>
        <% end %>
      </div>
    </div>
  </div>
</article>
