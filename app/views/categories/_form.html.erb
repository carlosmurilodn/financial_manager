<%= form_with model: category, local: true, html: { class: "app-form-page__form", data: { turbo: false } } do |f| %>
  <div class="row mb-3">
    <div class="col-md-3">
      <%= f.label :icon, "Ícone Google" %>
      <%= f.text_field :icon, class: "app-form-control", placeholder: "receipt_long" %>
    </div>

    <div class="col-md-5">
      <%= f.label :name, t("categories.form.name") %>
      <%= f.text_field :name, class: "app-form-control", required: true %>
    </div>

    <div class="col-md-4">
      <%= f.label :color, "Cor da categoria" %>
      <% selected_color = category.color.presence || Category::COLOR_PALETTE.values.first %>

      <div class="app-color-select-field">
        <%= f.select :color,
              options_for_select(Category::COLOR_PALETTE.to_a, selected_color),
              {},
              class: "app-form-select",
              data: { color_select: true } %>

        <span class="app-color-name-badge" style="--color-select-color: <%= selected_color %>;">
          <%= Category.color_name_for(selected_color) %>
        </span>
      </div>
    </div>
  </div>

  <div class="app-form-page__actions">
    <%= link_to "Cancelar", category.persisted? ? category_path(category) : categories_path, class: "app-btn app-btn--outline" %>
    <%= f.submit t("categories.form.submit"), class: "app-btn app-btn--primary" %>
  </div>
<% end %>

