<section class="app-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--categories">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon" style="background: color-mix(in srgb, <%= @category.display_color %> 14%, transparent);">
          <span class="material-symbols-rounded" style="color: <%= @category.display_color %>;"><%= @category.material_icon %></span>
        </span>
        <div>
          <h1 class="app-page__title"><%= @category.display_name %></h1>
        </div>
      </div>

      <div class="app-page__hero-unit" style="display: flex; align-items: center; justify-content: flex-end; gap: 10px;">
        <%= link_to categories_path, class: "app-show-back-link" do %>
          <span class="material-symbols-rounded">arrow_back</span>
          Voltar
        <% end %>

        <%= link_to edit_category_path(@category), class: "app-show-card__action-btn app-show-card__action-btn--edit", data: { turbo_frame: "modal" } do %>
          <span class="material-symbols-rounded">edit</span>
          Editar
        <% end %>

        <%= link_to category_path(@category), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta categoria?" }, class: "app-show-card__action-btn app-show-card__action-btn--danger" do %>
          <span class="material-symbols-rounded">delete</span>
          Excluir
        <% end %>
      </div>
    </div>
  </div>

  <%# KPIs %>
  <div class="app-panel app-show-panel">
    <div class="app-show-kpis">
      <div class="app-show-kpi" style="--kpi-color: #1b9c63;">
        <small>Receitas do Mês</small>
        <strong><%= number_to_currency(@incomes_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
      <div class="app-show-kpi" style="--kpi-color: #d83f4f;">
        <small>Despesas do Mês</small>
        <strong><%= number_to_currency(@expenses_total, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
    </div>
  </div>

  <%# Movimentações do mês %>
  <div class="app-panel app-show-panel">
    <div class="app-show-card" style="--expense-category-color: <%= @category.display_color %>;">
      <div class="app-show-card__expenses-header">
        <h3 class="app-show-card__installments-title">
          <span class="material-symbols-rounded">swap_vert</span>
          Movimentações
        </h3>

        <div class="app-show-card__month-nav">
          <%= link_to category_path(@category, month: @previous_date.month, year: @previous_date.year),
                      class: "app-show-card__month-btn" do %>
            <span class="material-symbols-rounded">chevron_left</span>
          <% end %>

          <span class="app-show-card__month-label">
            <%= I18n.l(@show_date, format: "%B de %Y") %>
          </span>

          <%= link_to category_path(@category, month: @next_date.month, year: @next_date.year),
                      class: "app-show-card__month-btn" do %>
            <span class="material-symbols-rounded">chevron_right</span>
          <% end %>
        </div>
      </div>

      <% if @category_expenses.any? || @category_incomes.any? %>
        <div class="app-show-card__installments-table-wrapper">
          <table class="app-show-card__installments-table">
            <thead>
              <tr>
                <th>Tipo</th>
                <th>Descrição</th>
                <th>Data</th>
                <th>Valor</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @category_incomes.each do |income| %>
                <tr>
                  <td><span class="expense-card__pill" style="background: color-mix(in srgb, #1b9c63 14%, transparent); color: #1b9c63;">Receita</span></td>
                  <td><%= link_to income.description.presence || "Sem descrição", income_path(income), class: "stealth-link" %></td>
                  <td><%= income.date&.strftime("%d/%m/%Y") %></td>
                  <td><strong style="color: #1b9c63;"><%= number_to_currency(income.amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong></td>
                  <td>
                    <span class="app-show-card__installment-status <%= income.paid? ? 'app-show-card__installment-status--paid' : 'app-show-card__installment-status--pending' %>">
                      <%= income.paid? ? "Recebida" : "Pendente" %>
                    </span>
                  </td>
                </tr>
              <% end %>
              <% @category_expenses.each do |expense| %>
                <tr>
                  <td><span class="expense-card__pill" style="background: color-mix(in srgb, #d83f4f 14%, transparent); color: #d83f4f;">Despesa</span></td>
                  <td><%= link_to expense.description, expense_path(expense), class: "stealth-link" %></td>
                  <td><%= expense.date.strftime("%d/%m/%Y") %></td>
                  <td><strong style="color: #d83f4f;"><%= number_to_currency(expense.effective_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong></td>
                  <td>
                    <span class="app-show-card__installment-status <%= expense.paid? ? 'app-show-card__installment-status--paid' : 'app-show-card__installment-status--pending' %>">
                      <%= expense.paid? ? "Pago" : "Pendente" %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="app-show-card__empty">
          <span class="material-symbols-rounded">category</span>
          <strong>Nenhuma movimentação neste mês</strong>
          <small>Receitas e despesas desta categoria aparecerão aqui.</small>
        </div>
      <% end %>
    </div>
  </div>
</section>
