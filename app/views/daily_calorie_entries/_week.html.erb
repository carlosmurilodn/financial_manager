<section id="calories-<%= week_start.iso8601 %>" class="calorie-week" aria-label="Calorias da semana de <%= week_start.strftime('%d/%m/%Y') %>">
  <% unless health_profile %>
    <div class="calorie-week__header">
      <%= link_to "Configurar perfil", health_profile_path, class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
  <div class="calorie-week__days">
    <% 7.times do |offset| %>
      <% date = week_start + offset.days %>
      <% entry = entries_by_date[date] || DailyCalorieEntry.new(occurred_on: date) %>
      <% nutrition = local_assigns.fetch(:nutrition, false) %>
      <% diet_day = local_assigns[:nutrition_goal]&.weekly_health_goal_days&.find { |day| day.occurred_on == date } if nutrition %>
      <%= render "daily_calorie_entries/day", entry: entry, nutrition: nutrition, diet_status: diet_day&.diet_status %>
    <% end %>
  </div>
</section>
