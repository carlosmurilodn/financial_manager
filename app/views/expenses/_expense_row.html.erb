<div
  id="<%= dom_id(expense) %>"
  class="expense-card expense-card--expense <%= expense.paid? ? 'expense-card--paid' : 'expense-card--pending' %>"
  style="--expense-category-color: <%= expense.category.display_color %>;"
>
  <% balance_date = expense.balance_month || expense.date %>

  <div class="expense-card__content">
    <div class="expense-card__identity-block">
      <div class="expense-card__identity-main">
        <div class="expense-card__icon-wrapper">
          <span class="material-symbols-rounded expense-card__icon"><%= expense.category.material_icon %></span>
        </div>

        <%= link_to expense_path(expense), class: "expense-card__description-link", aria: { label: "Ver detalhes de #{expense.description}" } do %>
          <h3 class="expense-card__title"><%= expense.description %></h3>
        <% end %>
      </div>

      <div class="expense-card__amount-area">
        <strong class="expense-card__amount">
          <%= number_to_currency(expense.effective_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
        </strong>

        <% if expense.payment_method_credito_parcelado? %>
          <%= link_to toggle_paid_options_expense_path(expense, month: params[:month]),
                      class: "expense-card__status #{expense.paid? ? 'expense-card__status--paid' : 'expense-card__status--pending'}",
                      aria: { label: (expense.paid? ? "Despesa paga" : "Despesa pendente") },
                      data: { turbo_frame: "modal" } do %>
            <span class="material-symbols-rounded expense-card__status-state-icon"><%= expense.paid? ? "check" : "schedule" %></span>
            <span class="expense-card__status-label"><%= expense.paid? ? "Pago" : "Pendente" %></span>
            <span class="material-symbols-rounded expense-card__status-mobile-icon" aria-hidden="true">attach_money</span>
          <% end %>
        <% else %>
          <%= link_to toggle_paid_expense_path(expense, month: params[:month]),
                      method: :patch,
                      data: { turbo_method: :patch, turbo_stream: true },
                      aria: { label: (expense.paid? ? "Despesa paga" : "Despesa pendente") },
                      class: "expense-card__status #{expense.paid? ? 'expense-card__status--paid' : 'expense-card__status--pending'}" do %>
            <span class="material-symbols-rounded expense-card__status-state-icon"><%= expense.paid? ? "check" : "schedule" %></span>
            <span class="expense-card__status-label"><%= expense.paid? ? "Pago" : "Pendente" %></span>
            <span class="material-symbols-rounded expense-card__status-mobile-icon" aria-hidden="true">attach_money</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="expense-card__badges">
      <span class="expense-card__pill"><%= Expense.payment_method_names[expense.payment_method] %></span>

      <% if expense.card.present? %>
        <%= link_to card_path(expense.card, month: balance_date.month, year: balance_date.year),
                    class: "expense-card__pill expense-card__pill--link",
                    style: "background: color-mix(in srgb, #{expense.card.display_color} 14%, transparent); color: #{expense.card.display_color};",
                    aria: { label: "Ver cartão #{expense.card.name}" } do %>
          <%= expense.card.name %>
        <% end %>
      <% end %>

      <% if expense.payment_method_credito_parcelado? %>
        <span class="expense-card__pill"><%= "Parcela #{expense.current_installment} de #{expense.installments_count}" %></span>
      <% end %>

      <%= link_to category_path(expense.category, month: balance_date.month, year: balance_date.year),
                  class: "expense-card__pill expense-card__pill--category expense-card__pill--link",
                  aria: { label: "Ver categoria #{expense.category.display_name}" } do %>
        <%= expense.category.display_name %>
      <% end %>
    </div>

    <div class="expense-card__footer">
      <div class="expense-card__information">
        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">calendar_month</span>
          <span><small>Data</small><strong><%= expense.date.strftime("%d/%m/%Y") %></strong></span>
        </span>

        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">event</span>
          <span><small>Balanço</small><strong><%= expense.balance_month&.strftime("%m/%Y") || "—" %></strong></span>
        </span>
      </div>

      <div class="expense-card__actions">
        <%= link_to(
              new_expense_path(duplicate_from: expense.id),
              class: "expense-card__action expense-card__action--duplicate",
              title: "Duplicar despesa",
              aria: { label: "Duplicar despesa #{expense.description}" }
            ) do %>
          <span class="material-symbols-rounded">content_copy</span>
          <span class="expense-card__action-label">Duplicar</span>
        <% end %>

        <%= link_to(
              edit_expense_path(expense),
              class: "expense-card__action",
              title: "Editar despesa",
              aria: { label: "Editar despesa #{expense.description}" }
            ) do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="expense-card__action-label">Editar</span>
        <% end %>

        <% if expense.payment_method_credito_parcelado? %>
          <%= link_to(
                delete_options_expense_path(expense),
                class: "expense-card__action expense-card__action--danger",
                title: "Excluir despesa",
                aria: { label: "Excluir despesa #{expense.description}" },
                data: { turbo_frame: "modal" }
              ) do %>
            <span class="material-symbols-rounded">delete</span>
            <span class="expense-card__action-label">Excluir</span>
          <% end %>
        <% else %>
          <%= link_to(
                expense_path(expense),
                data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                class: "expense-card__action expense-card__action--danger",
                title: "Excluir despesa",
                aria: { label: "Excluir despesa #{expense.description}" }
              ) do %>
            <span class="material-symbols-rounded">delete</span>
            <span class="expense-card__action-label">Excluir</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
