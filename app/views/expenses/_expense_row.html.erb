<div
  id="<%= dom_id(expense) %>"
  class="expense-card <%= expense.paid? ? 'expense-card--paid' : 'expense-card--pending' %>"
  style="--expense-category-color: <%= expense.category.display_color %>;"
>
  <div class="expense-card__border"></div>

  <div class="expense-card__content">
    <div class="expense-card__category">
      <div class="expense-card__icon-wrapper">
        <span class="material-symbols-rounded expense-card__icon">
          <%= expense.category.material_icon %>
        </span>
      </div>

      <div class="expense-card__details">
        <div class="expense-card__header">
          <h3 class="expense-card__title">
            <%= expense.category.display_name %>
          </h3>

          <div class="expense-card__badges">
            <span class="expense-card__pill">
              <%= Expense.payment_method_names[expense.payment_method] %>
            </span>

              <% if expense.card.present? %>
                <span class="expense-card__pill">
                  <%= expense.card.name %>
                </span>
              <% end %>

            <% if expense.payment_method_credito_parcelado? %>
              <span class="expense-card__pill">
                <%= "Parcela #{expense.current_installment} de #{expense.installments_count}" %>
              </span>
            <% end %>
          </div>
        </div>

      <div class="expense-card__description-row">
        <p class="expense-card__description">
          <%= link_to expense.description, expense_path(expense), class: "stealth-link" %>
        </p>

          <div class="expense-card__meta"> 
            <span class="expense-card__meta-item">
              <span class="material-symbols-rounded">calendar_month</span>
              <%= expense.date.strftime("%d/%m/%Y") %>
            </span>

            <span class="expense-card__meta-item">
              <span class="material-symbols-rounded">event</span>
              <%= expense.balance_month.strftime("%m/%Y") if expense.balance_month.present? %>
            </span>

            <span class="expense-card__meta-item">
              <span class="material-symbols-rounded">schedule</span>
              <%= expense.created_at.strftime("%d/%m/%Y") %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="expense-card__amount-area">
      <strong class="expense-card__amount">
        <%= number_to_currency(expense.effective_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
      </strong>

      <% if expense.payment_method_credito_parcelado? %>
        <%= link_to(
              expense.paid? ? "Pago" : "Pendente",
              toggle_paid_options_expense_path(expense, month: params[:month]),
              class: "expense-card__status #{expense.paid? ? 'expense-card__status--paid' : 'expense-card__status--pending'}",
              data: { turbo_frame: "modal" }
            ) %>
      <% else %>
        <%= link_to(
              expense.paid? ? "Pago" : "Pendente",
              toggle_paid_expense_path(expense, month: params[:month]),
              method: :patch,
              data: { turbo_method: :patch, turbo_stream: true },
              class: "expense-card__status #{expense.paid? ? 'expense-card__status--paid' : 'expense-card__status--pending'}"
            ) %>
      <% end %>
    </div>

    <div class="expense-card__actions">
      <%= link_to(
            edit_expense_path(expense),
            class: "expense-card__action",
            title: "Editar despesa",
            data: { turbo_frame: "modal" }
          ) do %>
        <span class="material-symbols-rounded">edit</span>
      <% end %>

      <% if expense.payment_method_credito_parcelado? %>
        <%= link_to(
              delete_options_expense_path(expense),
              class: "expense-card__action expense-card__action--danger",
              title: "Excluir despesa",
              data: { turbo_frame: "modal" }
            ) do %>
          <span class="material-symbols-rounded">delete</span>
        <% end %>
      <% else %>
        <%= link_to(
              expense_path(expense),
              data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
              class: "expense-card__action expense-card__action--danger",
              title: "Excluir despesa"
            ) do %>
          <span class="material-symbols-rounded">delete</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
