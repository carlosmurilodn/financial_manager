<% description = if @expense.payment_method_credito_parcelado?
  "Parcela #{@expense.current_installment}/#{@expense.installments_count}. Escolha o alcance da atualização ao salvar."
else
  "Revise os dados da despesa e salve as alterações."
end %>

<%= render layout: "shared/form_page", locals: {
  resource: @expense,
  title: "Editar despesa",
  eyebrow: "Despesas",
  description: description,
  icon: "edit_note",
  back_path: expense_path(@expense)
} do %>
    <%= render "form", expense: @expense %>
<% end %>
