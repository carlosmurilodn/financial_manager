<section class="app-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--expenses">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">receipt_long</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Gestão</p>
          <h1 class="app-page__title">Despesas</h1>
        </div>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>
    </div>

    <%# <p class="app-page__description">Filtre, acompanhe parcelas e mantenha o controle do que já foi pago.</p> %>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: expenses_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-grid app-filter-grid--expenses">
          <div class="app-filter-field">
            <%= f.label :description, "Descrição" %>
            <%= f.text_field :description, value: @description_filter, class: "app-form-control", placeholder: "Buscar descrição..." %>
          </div>

          <div class="app-filter-field">
            <%= f.label :month, "Mês" %>
            <%= f.select :month,
                  options_for_select(
                    [["Todos", 0]] + I18n.t("date.month_names")[1..12].map.with_index { |m, i| [m.capitalize, i + 1] },
                    @month || 0
                  ),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :year, "Ano" %>
            <%= f.select :year,
                  options_for_select([["Todos", 0]] + (2025..2030).to_a.reverse, @year || 0),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :category_id, "Categoria" %>
            <%= select_tag :category_id,
                options_for_select([["Todas", 0]] + current_user.categories.sort_by(&:sort_name).map { |c| [c.display_name, c.id] }, @category_filter || 0),
                class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :payment_method, "Pagamento" %>
            <%= f.select :payment_method,
                  options_for_select([["Todos", ""]] + Expense.payment_methods.keys.map { |k| [k.humanize, k] }, @payment_method_filter || ""),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :card_id, "Cartão" %>
            <%= f.select :card_id,
                  options_for_select([["Todos", 0]] + current_user.cards.order(:name).map { |c| [c.name, c.id] }, @card_filter || 0),
                  {}, class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :amount_min, "Valor mínimo" %>
            <%= f.text_field :amount_min, value: @amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :amount_max, "Valor máximo" %>
            <%= f.text_field :amount_max, value: @amount_max_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :paid, "Paga?" %>
            <div class="app-filter-toggle-group">
              <%= link_to "Todas",
                    expenses_path(request.query_parameters.except("paid").merge(paid: "")),
                    class: "app-filter-toggle-btn #{@paid_filter.blank? ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Sim",
                    expenses_path(request.query_parameters.merge(paid: "true")),
                    class: "app-filter-toggle-btn #{@paid_filter == 'true' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Não",
                    expenses_path(request.query_parameters.merge(paid: "false")),
                    class: "app-filter-toggle-btn #{@paid_filter == 'false' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
            </div>
          </div>

          <div class="app-filter-field">
            <%= f.label :installment, "Parcelada?" %>
            <div class="app-filter-toggle-group">
              <%= link_to "Todas",
                    expenses_path(request.query_parameters.except("installment").merge(installment: "")),
                    class: "app-filter-toggle-btn #{@installment_filter.blank? ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Sim",
                    expenses_path(request.query_parameters.merge(installment: "true")),
                    class: "app-filter-toggle-btn #{@installment_filter == 'true' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Não",
                    expenses_path(request.query_parameters.merge(installment: "false")),
                    class: "app-filter-toggle-btn #{@installment_filter == 'false' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
            </div>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_expenses_path,
                      class: "app-btn app-btn--secondary app-page__secondary-btn",
                      data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle me-1"></i> Limpar Filtros
          <% end %>

          <%= render "sort_select" %>

          <%= link_to report_pdf_expenses_path(request.query_parameters),
                      class: "app-btn app-btn--danger app-page__danger-btn",
                      target: "_blank" do %>
            <i class="bi bi-file-earmark-pdf me-1"></i> Gerar PDF
          <% end %>

          <%= render "shared/per_page_select" %>

        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "expenses_table" %>
  </div>
</section>

<turbo-frame id="modal" style="display: none;"></turbo-frame>

<div id="appModal" class="app-modal" aria-hidden="true">
  <div class="app-modal__backdrop" data-modal-backdrop="true"></div>

  <div class="app-modal__dialog">
    <div class="app-modal__content">
      <div id="app-modal-body"></div>
    </div>
  </div>
</div>
