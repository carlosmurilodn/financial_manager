<% back_path = if @expense_context_card.present?
  card_path(@expense_context_card, month: @expense_context_balance_date.month, year: @expense_context_balance_date.year)
else
  expenses_path
end %>

<%= render layout: "shared/form_page", locals: {
  resource: @expense,
  title: params[:duplicate_from].present? ? "Duplicar Despesa" : "Nova Despesa",
  eyebrow: "Despesas",
  description: params[:duplicate_from].present? ? "Revise os dados antes de salvar a nova despesa." : "Registre uma ou várias despesas com datas, categoria e forma de pagamento.",
  icon: "receipt_long",
  back_path: back_path
} do %>
    <%= render "form", expense: @expense %>
<% end %>
