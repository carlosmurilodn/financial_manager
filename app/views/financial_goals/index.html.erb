<section class="app-page">
  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Objetivos", path: financial_goals_path }
  ] %>

  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--financial-goals">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">flag</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Planejamento</p>
          <h1 class="app-page__title">Objetivos</h1>
        </div>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>

      <div class="app-page__hero-unit">
      </div>
    </div>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: financial_goals_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-grid app-filter-grid--financial-goals">
          <div class="app-filter-field">
            <%= f.label :description, "Descrição" %>
            <%= f.text_field :description, value: @description_filter, class: "app-form-control", placeholder: "Buscar objetivo..." %>
          </div>

          <div class="app-filter-field">
            <%= f.label :category_id, "Categoria" %>
            <%= f.select :category_id,
                  options_for_select([["Todas", 0]] + (@categories || []).map { |category| [category.display_name, category.id] }, @category_filter || 0),
                  {},
                  class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :progress_min, "Progresso" %>
            <%= f.number_field :progress_min, value: @progress_min_filter, class: "app-form-control", min: 0, max: 100, step: 1, placeholder: "%" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :status, "Status" %>
            <%= f.select :status,
                  options_for_select([["Todos", ""]] + FinancialGoal.statuses.keys.map { |status| [FinancialGoal::STATUS_LABELS.fetch(status), status] }, @status_filter || ""),
                  {},
                  class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :priority, "Prioridade" %>
            <%= f.select :priority,
                  options_for_select([["Todas", ""]] + FinancialGoal.priorities.keys.map { |priority| [FinancialGoal::PRIORITY_LABELS.fetch(priority), priority] }, @priority_filter || ""),
                  {},
                  class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :due_until, "Data Prevista" %>
            <%= f.text_field :due_until,
                  value: @due_until_filter,
                  class: "app-form-control custom-date",
                  autocomplete: "off",
                  placeholder: "dd/mm/aaaa" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :current_amount_min, "Valor Atual" %>
            <%= f.text_field :current_amount_min, value: @current_amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :target_amount_min, "Valor Alvo" %>
            <%= f.text_field :target_amount_min, value: @target_amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :credit_amount_min, "Crédito" %>
            <%= f.text_field :credit_amount_min, value: @credit_amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :potential_amount_min, "Total" %>
            <%= f.text_field :potential_amount_min, value: @potential_amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :remaining_amount_max, "Falta" %>
            <%= f.text_field :remaining_amount_max, value: @remaining_amount_max_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :monthly_amount_max, "Aporte" %>
            <%= f.text_field :monthly_amount_max, value: @monthly_amount_max_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel app-me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_financial_goals_path,
                      class: "app-btn app-btn--secondary app-page__secondary-btn",
                      data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle app-me-1"></i> Limpar Filtros
          <% end %>

          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "financial_goals_list" %>
  </div>
</section>

<turbo-frame id="modal" style="display: none;"></turbo-frame>

<div id="appModal" class="app-modal" aria-hidden="true">
  <div class="app-modal__backdrop" data-modal-backdrop="true"></div>

  <div class="app-modal__dialog">
    <div class="app-modal__content">
      <div id="app-modal-body"></div>
    </div>
  </div>
</div>
