<% goal_color = @financial_goal.display_color %>
<% category = @financial_goal.category %>

<section class="app-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--financial-goals app-page__hero-top--show">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon" style="background: color-mix(in srgb, <%= goal_color %> 14%, transparent);">
          <span class="material-symbols-rounded" style="color: <%= goal_color %>;"><%= category&.material_icon || "flag" %></span>
        </span>
        <div>
          <h1 class="app-page__title"><%= @financial_goal.description %></h1>
        </div>
      </div>

      <div class="app-page__hero-unit app-show-page__hero-actions">
        <%= link_to financial_goals_path, class: "app-show-back-link" do %>
          <span class="material-symbols-rounded">arrow_back</span>
          Voltar
        <% end %>

        <%= link_to edit_financial_goal_path(@financial_goal), class: "app-show-card__action-btn app-show-card__action-btn--edit" do %>
          <span class="material-symbols-rounded">edit</span>
          Editar
        <% end %>

        <%= link_to financial_goal_path(@financial_goal), data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este objetivo?" }, class: "app-show-card__action-btn app-show-card__action-btn--danger" do %>
          <span class="material-symbols-rounded">delete</span>
          Excluir
        <% end %>
      </div>
    </div>
  </div>

  <%# KPIs %>
  <div class="app-panel app-show-panel">
    <div class="app-show-kpis">
      <div class="app-show-kpi" style="--kpi-color: #1b9c63;">
        <small>Valor Atual</small>
        <strong><%= number_to_currency(@financial_goal.progress_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
      <div class="app-show-kpi" style="--kpi-color: var(--nav-active-icon-color);">
        <small>Meta</small>
        <strong><%= number_to_currency(@financial_goal.target_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
      <div class="app-show-kpi" style="--kpi-color: #d83f4f;">
        <small>Falta</small>
        <strong><%= number_to_currency(@financial_goal.remaining_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
      <div class="app-show-kpi" style="--kpi-color: var(--text-soft);">
        <small>Progresso</small>
        <strong><%= number_to_percentage(@financial_goal.progress_percent, precision: 0) %></strong>
        <div class="app-show-kpi__progress">
          <span class="app-show-kpi__progress-used" style="width: <%= @financial_goal.progress_percent.round(1) %>%; background: #1b9c63;"></span>
          <span class="app-show-kpi__progress-available" style="width: <%= (100 - @financial_goal.progress_percent).round(1) %>%; background: rgba(148, 163, 184, 0.3);"></span>
        </div>
      </div>
      <div class="app-show-kpi" style="--kpi-color: var(--text-soft);">
        <small>Aporte Mensal</small>
        <strong><%= number_to_currency(@financial_goal.monthly_required_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
      </div>
      <div class="app-show-kpi" style="--kpi-color: var(--text-soft);">
        <small>Prazo</small>
        <strong><%= @financial_goal.due_date.strftime("%d/%m/%Y") %></strong>
      </div>
    </div>
  </div>

  <%# Informações %>
  <div class="app-panel app-show-panel">
    <div class="app-show-card" style="--expense-category-color: <%= goal_color %>;">
      <div class="app-show-card__header">
        <div class="app-show-card__icon-wrapper">
          <span class="material-symbols-rounded app-show-card__icon">
            <%= category&.material_icon || "flag" %>
          </span>
        </div>

        <div class="app-show-card__title-area">
          <div class="app-show-card__title-row">
            <h2 class="app-show-card__title"><%= @financial_goal.description %></h2>
            <div class="app-show-card__badges">
              <span class="app-show-card__pill"><%= @financial_goal.status_label %></span>
              <span class="app-show-card__pill"><%= @financial_goal.priority_label %></span>
              <span class="app-show-card__pill"><%= category&.display_name || "Sem categoria" %></span>
            </div>
          </div>
          <div class="app-show-card__subtitle-row">
            <strong class="app-show-card__amount">
              <%= number_to_currency(@financial_goal.progress_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
            </strong>
            <span class="app-show-card__status app-show-card__status--pending">
              Meta <%= number_to_currency(@financial_goal.target_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
            </span>
          </div>
        </div>
      </div>

      <div class="app-show-card__details-grid">
        <div class="app-show-card__detail">
          <span class="material-symbols-rounded">event</span>
          <div>
            <small>Data Prevista</small>
            <strong><%= @financial_goal.due_date.strftime("%d/%m/%Y") %></strong>
          </div>
        </div>

        <div class="app-show-card__detail">
          <span class="material-symbols-rounded">timer</span>
          <div>
            <small>Meses Restantes</small>
            <strong><%= @financial_goal.months_until_due %></strong>
          </div>
        </div>

        <div class="app-show-card__detail">
          <span class="material-symbols-rounded">schedule</span>
          <div>
            <small>Criado em</small>
            <strong><%= @financial_goal.created_at.strftime("%d/%m/%Y") %></strong>
          </div>
        </div>

        <% if @financial_goal.notes.present? %>
          <div class="app-show-card__detail">
            <span class="material-symbols-rounded">notes</span>
            <div>
              <small>Observações</small>
              <strong><%= @financial_goal.notes %></strong>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Recursos %>
  <% if @financial_goal.financial_goal_resources.any? %>
    <div class="app-panel app-show-panel">
      <div class="app-show-card" style="--expense-category-color: <%= goal_color %>;">
        <h3 class="app-show-card__installments-title">
          <span class="material-symbols-rounded">account_balance_wallet</span>
          Recursos Vinculados
        </h3>

        <div class="app-show-card__installments-table-wrapper">
          <table class="app-show-card__installments-table">
            <thead>
              <tr>
                <th>Descrição</th>
                <th>Tipo</th>
                <th>Valor</th>
                <th>Incluso no Total</th>
              </tr>
            </thead>
            <tbody>
              <% @financial_goal.financial_goal_resources.each do |resource| %>
                <tr>
                  <td><%= resource.description %></td>
                  <td><span class="expense-card__pill"><%= resource.resource_type_label %></span></td>
                  <td class="app-table__currency"><strong><%= number_to_currency(resource.effective_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong></td>
                  <td>
                    <span class="app-show-card__installment-status <%= resource.include_in_total? ? 'app-show-card__installment-status--paid' : 'app-show-card__installment-status--pending' %>">
                      <%= resource.include_in_total? ? "Sim" : "Não" %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# Totais dos recursos %>
        <div class="app-show-kpis" style="margin-top: 16px;">
          <div class="app-show-kpi" style="--kpi-color: #1b9c63;">
            <small>Recursos Próprios</small>
            <strong><%= number_to_currency(@financial_goal.own_resources_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
          </div>
          <div class="app-show-kpi" style="--kpi-color: var(--nav-active-icon-color);">
            <small>Limite de Crédito</small>
            <strong><%= number_to_currency(@financial_goal.credit_limit_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
          </div>
          <div class="app-show-kpi" style="--kpi-color: var(--text-soft);">
            <small>Total Potencial</small>
            <strong><%= number_to_currency(@financial_goal.potential_amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>
