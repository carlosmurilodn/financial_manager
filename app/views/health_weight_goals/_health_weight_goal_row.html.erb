<% reached = health_weight_goal.reached_by?(@latest_weight_entry) %>

<div
  id="<%= dom_id(health_weight_goal) %>"
  class="expense-card expense-card--expense <%= reached ? "expense-card--paid" : "expense-card--pending" %>"
  style="--expense-category-color: #5c6df2;"
>
  <div class="expense-card__content">
    <div class="expense-card__identity-block">
      <div class="expense-card__identity-main">
        <div class="expense-card__icon-wrapper">
          <span class="material-symbols-rounded expense-card__icon"><%= reached ? "task_alt" : "flag" %></span>
        </div>

        <div class="expense-card__description-link">
          <h3 class="expense-card__title"><%= health_weight_goal.kind_label %></h3>
        </div>
      </div>

      <div class="expense-card__amount-area">
        <strong class="expense-card__amount">
          <%= number_with_precision(health_weight_goal.target_weight, precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg
        </strong>

        <span class="expense-card__status <%= reached ? "expense-card__status--paid" : "expense-card__status--pending" %>">
          <span class="material-symbols-rounded expense-card__status-state-icon"><%= reached ? "check" : "schedule" %></span>
          <span class="expense-card__status-label"><%= reached ? "Cumprida" : "Pendente" %></span>
          <span class="material-symbols-rounded expense-card__status-mobile-icon" aria-hidden="true">flag</span>
        </span>
      </div>
    </div>

    <div class="expense-card__badges">
      <span class="expense-card__pill">Saúde</span>
      <span class="expense-card__pill"><%= health_weight_goal.final? ? "Final" : "Intermediária" %></span>
    </div>

    <div class="expense-card__footer">
      <div class="expense-card__information">
        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">monitor_weight</span>
          <span><small>Peso alvo</small><strong><%= number_with_precision(health_weight_goal.target_weight, precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg</strong></span>
        </span>

        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">sort</span>
          <span><small>Ordem</small><strong><%= health_weight_goal.position %></strong></span>
        </span>
      </div>

      <div class="expense-card__actions">
        <%= link_to edit_health_weight_goal_path(health_weight_goal),
                    class: "expense-card__action",
                    title: "Editar meta",
                    aria: { label: "Editar meta de #{number_with_precision(health_weight_goal.target_weight, precision: 2, strip_insignificant_zeros: true, separator: ",")} kg" } do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="expense-card__action-label">Editar</span>
        <% end %>

        <%= link_to health_weight_goal_path(health_weight_goal),
                    data: { turbo_method: :delete, turbo_confirm: "Excluir esta meta?" },
                    class: "expense-card__action expense-card__action--danger",
                    title: "Excluir meta",
                    aria: { label: "Excluir meta de #{number_with_precision(health_weight_goal.target_weight, precision: 2, strip_insignificant_zeros: true, separator: ",")} kg" } do %>
          <span class="material-symbols-rounded">delete</span>
          <span class="expense-card__action-label">Excluir</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
