<div
  class="expense-card expense-card--expense <%= milestone[:status] == "done" ? "expense-card--paid" : "expense-card--pending" %>"
  style="--expense-category-color: #5c6df2;"
>
  <div class="expense-card__content">
    <div class="expense-card__identity-block">
      <div class="expense-card__identity-main">
        <div class="expense-card__icon-wrapper">
          <span class="material-symbols-rounded expense-card__icon"><%= milestone[:status] == "done" ? "task_alt" : "flag" %></span>
        </div>

        <div class="expense-card__description-link">
          <h3 class="expense-card__title"><%= milestone[:kind] %></h3>
        </div>
      </div>

      <div class="expense-card__amount-area">
        <strong class="expense-card__amount">
          <%= number_with_precision(milestone[:weight], precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg
        </strong>

        <span class="expense-card__status <%= milestone[:status] == "done" ? "expense-card__status--paid" : "expense-card__status--pending" %>">
          <span class="material-symbols-rounded expense-card__status-state-icon"><%= milestone[:status] == "done" ? "check" : "schedule" %></span>
          <span class="expense-card__status-label"><%= milestone[:status_label] %></span>
          <span class="material-symbols-rounded expense-card__status-mobile-icon" aria-hidden="true">flag</span>
        </span>
      </div>
    </div>

    <div class="expense-card__badges">
      <span class="expense-card__pill">Saúde</span>
      <span class="expense-card__pill">Objetivos por Etapa</span>
    </div>

    <div class="expense-card__footer">
      <div class="expense-card__information">
        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">monitor_weight</span>
          <span><small>Peso alvo</small><strong><%= number_with_precision(milestone[:weight], precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg</strong></span>
        </span>

        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">flag</span>
          <span><small>Tipo</small><strong><%= milestone[:kind] %></strong></span>
        </span>
      </div>

      <div class="expense-card__actions">
        <%= link_to edit_health_weight_goal_path,
                    class: "expense-card__action",
                    title: "Editar objetivo",
                    aria: { label: "Editar objetivo de peso" } do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="expense-card__action-label">Editar</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
