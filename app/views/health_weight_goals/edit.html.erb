<%= render layout: "shared/form_page", locals: {
  resource: @health_weight_goal,
  title: "Objetivo de peso",
  eyebrow: "Progresso",
  description: "Defina seu peso desejado e os marcos intermediários. O foco continua na rotina e na consistência.",
  icon: "flag",
  back_path: health_weight_goal_path
} do %>
  <%= form_with model: @health_weight_goal, url: health_weight_goal_path, method: :patch, local: true, html: { class: "app-form-page__form", data: { turbo: false } } do |f| %>
    <div class="progress-review-form">
      <div>
        <%= f.label :target_weight, "Peso desejado (kg)" %>
        <%= f.text_field :target_weight, class: "app-form-control", required: true, inputmode: "decimal", placeholder: "Ex.: 99,9" %>
        <small>Use vírgula ou ponto, com até duas casas decimais.</small>
      </div>
      <div>
        <%= f.label :milestones_text, "Marcos intermediários (opcional)" %>
        <%= f.text_area :milestones_text, class: "app-form-control", rows: 5, placeholder: "110\n105", aria: { describedby: "weight-goal-milestones-hint" } %>
        <small id="weight-goal-milestones-hint">Até dez pesos, um por linha ou separados por ponto e vírgula. Cada marco deve ser maior que o peso desejado. Os marcos serão exibidos do maior ao menor.</small>
      </div>
      <p class="progress-empty">Peso inicial vem da primeira medição registrada. Alterar o objetivo não modifica seu histórico de peso, metas semanais ou revisões.</p>
    </div>
    <div class="app-form-page__actions">
      <%= link_to "Cancelar", health_weight_goal_path, class: "app-btn app-btn--outline" %>
      <%= f.submit "Salvar objetivo", class: "app-btn app-btn--primary" %>
    </div>
  <% end %>
<% end %>
