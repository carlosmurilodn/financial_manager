<section class="app-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--health-goals">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">flag</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Saúde e Bem-Estar</p>
          <h1 class="app-page__title">Objetivos por Etapa</h1>
        </div>
      </div>

      <div class="app-page__hero-unit app-page__hero-action">
        <%= link_to new_health_weight_goal_path, class: "app-expenses-hero-kpis__action", data: { turbo: false } do %>
          <span class="app-expenses-hero-kpis__action-icon">
            <span class="material-symbols-rounded">add</span>
          </span>
          <span class="app-expenses-hero-kpis__action-copy">
            <strong>Nova Meta</strong>
          </span>
        <% end %>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>
    </div>

    <%# <p class="app-page__description">Marcos intermediários e meta final cadastrados individualmente.</p> %>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: health_weight_goals_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-grid app-filter-grid--expenses">
          <div class="app-filter-field">
            <%= f.label :status, "Status" %>
            <%= f.select :status,
                  options_for_select([["Todos", ""], ["Cumpridos", "done"], ["Pendentes", "pending"]], @status_filter),
                  {},
                  class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= f.label :goal_type, "Tipo" %>
            <%= f.select :goal_type,
                  options_for_select([["Todos", ""], ["Intermediária", "intermediate"], ["Final", "final"]], @goal_type_filter),
                  {},
                  class: "app-form-select" %>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_health_weight_goals_path,
                      class: "app-btn app-btn--secondary app-page__secondary-btn",
                      data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle me-1"></i> Limpar Filtros
          <% end %>

          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "health_weight_goals_list" %>
  </div>
</section>
