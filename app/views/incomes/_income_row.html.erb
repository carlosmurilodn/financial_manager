<% category = income.category %>
<% category_color = category&.display_color || "#22a889" %>
<% category_icon = category&.material_icon || "payments" %>
<% balance_date = income.balance_month || income.date || Date.current %>

<div
  id="<%= dom_id(income) %>"
  class="expense-card expense-card--expense income-card <%= income.paid? ? 'expense-card--paid' : 'expense-card--pending' %>"
  style="--expense-category-color: <%= category_color %>;"
>
  <div class="expense-card__border"></div>

  <div class="expense-card__content">
    <div class="expense-card__identity-block">
      <div class="expense-card__icon-wrapper">
        <span class="material-symbols-rounded expense-card__icon"><%= category_icon %></span>
      </div>

      <%= link_to income_path(income), class: "expense-card__description-link", aria: { label: "Ver detalhes de #{income.description.presence || 'receita'}" } do %>
        <h3 class="expense-card__title"><%= income.description.presence || "Sem descrição" %></h3>
      <% end %>
    </div>

    <div class="expense-card__badges">
      <span class="expense-card__pill">Receita</span>

      <% if category.present? %>
        <%= link_to category_path(category, month: balance_date.month, year: balance_date.year),
                    class: "expense-card__pill expense-card__pill--category expense-card__pill--link",
                    aria: { label: "Ver categoria #{category.display_name}" } do %>
          <%= category.display_name %>
        <% end %>
      <% else %>
        <span class="expense-card__pill expense-card__pill--category">Sem categoria</span>
      <% end %>
    </div>

    <div class="expense-card__information">
      <span class="expense-card__meta-item">
        <span class="material-symbols-rounded">calendar_month</span>
        <span><small>Data</small><strong><%= income.date&.strftime("%d/%m/%Y") || "—" %></strong></span>
      </span>

      <span class="expense-card__meta-item">
        <span class="material-symbols-rounded">event</span>
        <span><small>Balanço</small><strong><%= income.balance_month&.strftime("%m/%Y") || "—" %></strong></span>
      </span>
    </div>

    <div class="expense-card__amount-area">
      <strong class="expense-card__amount">
        <%= number_to_currency(income.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
      </strong>

      <%= link_to toggle_paid_income_path(income),
                  method: :patch,
                  data: { turbo_method: :patch, turbo_stream: true },
                  class: "expense-card__status #{income.paid? ? 'expense-card__status--paid' : 'expense-card__status--pending'}" do %>
        <span class="material-symbols-rounded"><%= income.paid? ? "check" : "schedule" %></span>
        <%= income.paid? ? "Recebida" : "Pendente" %>
      <% end %>
    </div>

    <div class="expense-card__actions">
      <%= link_to edit_income_path(income), class: "expense-card__action", title: "Editar receita" do %>
        <span class="material-symbols-rounded">edit</span>
        <span class="expense-card__action-label">Editar</span>
      <% end %>

      <%= link_to income_path(income),
                  data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" },
                  class: "expense-card__action expense-card__action--danger",
                  title: "Excluir receita" do %>
        <span class="material-symbols-rounded">delete</span>
        <span class="expense-card__action-label">Excluir</span>
      <% end %>
    </div>
  </div>
</div>
