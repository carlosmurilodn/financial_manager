<section class="app-page">
  <%= render "shared/breadcrumbs", breadcrumbs: [
    { label: "Receitas", path: incomes_path }
  ] %>

  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--incomes">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">payments</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Gestão</p>
          <h1 class="app-page__title">Receitas</h1>
          <%# <p class="app-page__description">Organize suas entradas, acompanhe recebimentos e veja a evolução do caixa.</p> %>
        </div>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>

      <div class="app-page__hero-unit">
        <%= render "shared/app_page_hero_badge" %>
      </div>
    </div>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: incomes_path, method: :get, local: true, class: "app-filter-form" do %>
        <div class="app-filter-grid app-filter-grid--incomes">
          <div class="app-filter-field">
            <%= label_tag :month, "Mês" %>
            <%= select_tag :month,
              options_for_select([["Todos", 0]] + I18n.t("date.month_names")[1..12].map.with_index { |m, i| [m.capitalize, i + 1] }, @month || 0),
              class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :year, "Ano" %>
            <%= select_tag :year,
              options_for_select([["Todos", 0]] + (Date.today.year - 5..Date.today.year + 1).to_a.reverse, @year || 0),
              class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :description, "Descrição" %>
            <%= text_field_tag :description, @description_filter, class: "app-form-control", placeholder: "Buscar descrição..." %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :category_id, "Categoria" %>
            <%= select_tag :category_id,
              options_for_select([["Todas", 0]] + current_user.categories.sort_by(&:sort_name).map { |c| [c.display_name, c.id] }, @category_filter || 0),
              class: "app-form-select" %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :amount_min, "Valor mínimo" %>
            <%= text_field_tag :amount_min, @amount_min_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :amount_max, "Valor máximo" %>
            <%= text_field_tag :amount_max, @amount_max_filter, class: "app-form-control moeda", placeholder: "R$ 0,00" %>
          </div>

          <div class="app-filter-field">
            <%= label_tag :paid, "Recebida?" %>
            <div class="app-filter-toggle-group">
              <%= link_to "Todas",
                    incomes_path(request.query_parameters.except("paid").merge(paid: "")),
                    class: "app-filter-toggle-btn #{@paid_filter.blank? ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Sim",
                    incomes_path(request.query_parameters.merge(paid: "true")),
                    class: "app-filter-toggle-btn #{@paid_filter == 'true' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
              <%= link_to "Não",
                    incomes_path(request.query_parameters.merge(paid: "false")),
                    class: "app-filter-toggle-btn #{@paid_filter == 'false' ? 'is-active' : ''}",
                    data: { turbo_action: "replace" } %>
            </div>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= button_tag type: "submit", class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_incomes_path,
                  class: "app-btn app-btn--secondary app-page__secondary-btn",
                  data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle me-1"></i> Limpar Filtros
          <% end %>

          <%= render "sort_select" %>

          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "incomes_table" %>
  </div>
</section>

<turbo-frame id="modal" style="display: none;"></turbo-frame>

<div id="appModal" class="app-modal" aria-hidden="true">
  <div class="app-modal__backdrop" data-modal-backdrop="true"></div>

  <div class="app-modal__dialog">
    <div class="app-modal__content">
      <div id="app-modal-body"></div>
    </div>
  </div>
</div>
