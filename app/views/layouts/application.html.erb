<!DOCTYPE html>
<html>
  <head>
    <title>Gerenciador Pessoal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "/icon.png?v=personal-3", type: "image/png" %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <meta name="theme-color" content="#5871e7">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <script>
      const themeMedia = window.matchMedia("(prefers-color-scheme: dark)");
      const mobileMedia = window.matchMedia("(max-width: 991px)");
      const savedPreference = localStorage.getItem("app-theme-preference");
      const legacyTheme = localStorage.getItem("app-theme");
      const validPreferences = ["system", "fincan", "night"];
      const themePreference = validPreferences.includes(savedPreference)
        ? savedPreference
        : mobileMedia.matches
          ? "system"
          : ["fincan", "night"].includes(legacyTheme)
            ? legacyTheme
            : "fincan";
      const activeTheme = themePreference === "system"
        ? themeMedia.matches ? "night" : "fincan"
        : themePreference;
      document.documentElement.dataset.theme = activeTheme;
      localStorage.setItem("app-theme-preference", themePreference);
      localStorage.setItem("app-theme", activeTheme);
    </script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" %>
  </head>

  <%= render "shared/calculator_modal" %>

  <body>
    <div id="wrapper" class="app-shell <%= "app-shell--entry" if controller_name == "entry" %>">
      <%= render "shared/sidebar" unless controller_name == "entry" %>

      <main id="page-content-wrapper" class="app-content">
        <div class="app-content__inner">
          <div id="app-flash-container">
            <%= render "shared/flash_messages" %>
          </div>

          <%= yield %>

          <% unless controller_name == "entry" %>
            <footer class="app-footer">
              <div class="app-footer__brand">
                <span class="material-symbols-rounded app-footer__icon"><%= health_section? ? "self_improvement" : "finance_mode" %></span>
                <div>
                  <strong><%= health_section? ? "Saúde e Bem-Estar" : "Dashboard Financeiro" %></strong>
                  <small><%= health_section? ? "Acompanhe sua saúde, cuide da rotina e reconheça suas conquistas." : "Controle receitas, despesas e previsoes em um unico painel." %></small>
                </div>
              </div>

              <div class="app-footer__meta">
                <% (health_section? ? ["Autoconhecimento", "Metas Semanais", "Minha Evolução"] : ["Agenda Mensal", "Planejamento Anual", "Visao Consolidada"]).each do |label| %>
                  <span class="app-footer__chip"><%= label %></span>
                <% end %>
              </div>

              <div class="app-footer__credit">
                <small>Desenvolvido por</small>
                <strong>Carlos Murilo Duarte Novais</strong>
                <span><%= Date.current.year %></span>
              </div>
            </footer>
          <% end %>
        </div>
      </main>
    </div>
  </body>
</html>
