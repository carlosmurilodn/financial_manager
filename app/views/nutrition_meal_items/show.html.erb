<section class="app-page exercise-entry-show self-knowledge-page nutrition-item-show">
  <header class="app-page__hero">
    <div class="exercise-entry-show__header">
      <div class="app-page__hero-copy">
        <span class="app-page__hero-icon"><span class="material-symbols-rounded" aria-hidden="true">restaurant</span></span>
        <div>
          <p class="app-page__eyebrow">Alimentação · <%= @meal.name %></p>
          <h1 class="app-page__title"><%= @item.name %></h1>
          <p class="app-page__description"><%= @meal.occurred_on.strftime("%d/%m/%Y") %> · <%= { "taco" => "TACO", "custom" => "Meus Alimentos", "recipe" => "Receitas" }[@item.source] %> · <%= taco_nutrient_value(@item.quantity_grams) %> g consumidos</p>
        </div>
      </div>
      <div class="exercise-entry-show__actions">
        <%= link_to nutrition_meal_nutrition_meal_item_path(@meal, @item), class: "app-btn app-btn--danger", data: { turbo_method: :delete, turbo_confirm: "Excluir este item da refeição?" } do %>
          <span class="material-symbols-rounded" aria-hidden="true">delete</span><span>Excluir lançamento</span>
        <% end %>
        <%= link_to meal_week_path, class: "app-btn app-btn--outline" do %>
          <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span><span>Voltar à semana</span>
        <% end %>
      </div>
    </div>
  </header>
  <div class="nutrition-item-show__overview">
    <div class="nutrition-item-show__quantity">
      <h2>Quantidade consumida e refeição</h2>
      <%= form_with scope: :nutrition_meal_item, url: nutrition_meal_nutrition_meal_item_path(@meal, @item), method: :patch, class: "nutrition-meal-item-quantity" do |f| %>
        <div class="app-filter-field">
          <%= f.label :quantity_grams, "Quantidade (g)", for: "meal-item-show-quantity-#{@item.id}" %>
          <%= f.number_field :quantity_grams, value: @quantity || @item.quantity_grams, id: "meal-item-show-quantity-#{@item.id}", class: "app-form-control", min: "0.0001", max: "99999999.9999", step: "0.0001", required: true %>
        </div>
        <div class="app-filter-field nutrition-item-show__meal-field">
          <%= f.label :destination_meal_id, "Refeição", for: "meal-item-show-meal-#{@item.id}" %>
          <%= f.select :destination_meal_id, options_from_collection_for_select(@meal_options, :id, :name, @destination_meal_id || @meal.id), {}, id: "meal-item-show-meal-#{@item.id}", class: "app-form-select" %>
        </div>
        <%= f.button type: "submit", class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">save</span><span>Salvar alterações</span><% end %>
      <% end %>
    </div>
    <div class="nutrition-item-show__kpis">
      <% { calories: ["Calorias", "kcal"], carbohydrates: ["Carboidratos", "g"], proteins: ["Proteínas", "g"], fats: ["Gorduras", "g"] }.each do |field, (label, unit)| %>
        <div class="nutrition-item-show__kpi nutrition-day-kpi--<%= field %>"><span><%= label %></span><strong><%= meal_item_nutrient_value(@nutrients[field]) %> <small><%= unit %></small></strong></div>
      <% end %>
    </div>
  </div>
  <div class="nutrition-item-show__groups">
    <% Nutrition::MealItemDetails::GROUPS.each do |group, fields| %>
      <article class="app-panel nutrition-item-show__group">
        <h2><%= group %></h2>
        <table class="nutrition-item-show__table">
          <thead><tr><th scope="col">Nutriente</th><th scope="col"><%= taco_nutrient_value(@item.quantity_grams) %> g</th><th scope="col">100 g</th></tr></thead>
          <tbody>
            <% fields.each do |field, (label, unit, _)| %>
              <% value = @nutrients[field] %>
              <tr><th scope="row"><%= label %> <small>(<%= unit %>)</small></th><td><%= meal_item_nutrient_value(value) %></td><td><%= meal_item_nutrient_value(value * 100 / @item.quantity_grams) unless value.nil? %><%= "—" if value.nil? %></td></tr>
            <% end %>
          </tbody>
        </table>
      </article>
    <% end %>
  </div>
  <p class="nutrition-recipe-note">Calorias e macronutrientes correspondem ao lançamento; demais nutrientes usam o cadastro atual ou a composição atual da receita. — indica informação indisponível, não zero.</p>
</section>
