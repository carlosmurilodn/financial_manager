<div class="app-table-responsive">
  <table class="app-table nutrition-recipe-table">
    <caption>Valores nutricionais da preparação</caption>
    <thead><tr><th scope="col">Quantidade</th><th scope="col">Calorias (kcal)</th><th scope="col">Carboidratos (g)</th><th scope="col">Proteínas (g)</th><th scope="col">Gorduras (g)</th></tr></thead>
    <tbody>
      <% { whole: "Receita inteira", per_100g: "Por 100 g", per_serving: "Por porção" }.each do |basis, label| %>
        <tr><th scope="row"><%= label %></th>
          <% NutritionRecipeIngredient::NUTRIENTS.each do |field| %>
            <td data-nutrition-recipe-form-target="total" data-basis="<%= basis %>" data-nutrient="<%= field %>"><%= taco_nutrient_value(totals.dig(basis, field)) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="nutrition-recipe-note">“—” indica informação nutricional ausente ou quantidade ainda não informada. Nutrientes ausentes em um ingrediente deixam o respectivo total não informado.</p>
