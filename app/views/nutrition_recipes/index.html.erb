<section class="app-page health-index-page self-knowledge-page">
  <%= render "breadcrumbs" %>
  <header class="app-page__hero"><div class="exercise-entry-show__header">
    <div class="app-page__hero-copy"><span class="app-page__hero-icon"><span class="material-symbols-rounded" aria-hidden="true">menu_book</span></span><div><p class="app-page__eyebrow">Cadastros Básicos</p><h1 class="app-page__title">Receitas</h1></div></div>
    <%= link_to new_nutrition_recipe_path, class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">add</span><span>Nova Receita</span><% end %>
  </div></header>
  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: nutrition_recipes_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-field"><%= f.label :name, "Nome" %><%= f.search_field :name, value: @name_filter, class: "app-form-control", placeholder: "Buscar receita" %></div>
        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt</span> Filtrar<% end %>
          <%= link_to nutrition_recipes_path, class: "app-btn app-btn--secondary" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt_off</span> Limpar Filtros<% end %>
          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <div class="app-panel app-panel--table">
    <% if @recipes.any? %>
      <div class="app-table-responsive"><table class="app-table nutrition-recipe-table">
        <caption><%= @filtered_count %> receita(s) encontrada(s)</caption>
        <thead><tr><th scope="col"><%= sortable_table_header("Nome", :name) %></th><th scope="col"><%= sortable_table_header("Peso final (g)", :final_weight_grams) %></th><th scope="col"><%= sortable_table_header("Porções", :servings) %></th><th scope="col">Ações</th></tr></thead>
        <tbody><% @recipes.each do |recipe| %><tr>
          <th scope="row"><%= recipe.name %></th><td><%= taco_nutrient_value(recipe.final_weight_grams) %></td><td><%= recipe.servings %></td>
          <td><div class="nutrition-recipe-actions">
            <%= link_to nutrition_recipe_path(recipe), class: "app-btn app-btn--outline", title: "Visualizar receita" do %><span class="material-symbols-rounded" aria-hidden="true">visibility</span> Visualizar<% end %>
            <%= link_to edit_nutrition_recipe_path(recipe), class: "app-btn app-btn--outline", title: "Editar receita" do %><span class="material-symbols-rounded" aria-hidden="true">edit</span> Editar<% end %>
            <%= link_to nutrition_recipe_path(recipe), class: "app-btn app-btn--danger", title: "Excluir receita", data: { turbo_method: :delete, turbo_confirm: "Excluir esta receita?" } do %><span class="material-symbols-rounded" aria-hidden="true">delete</span> Excluir<% end %>
          </div></td>
        </tr><% end %></tbody>
      </table></div>
    <% else %>
      <div class="dashboard-empty-state"><span class="material-symbols-rounded" aria-hidden="true">menu_book</span><strong>Nenhuma receita encontrada</strong><small>Cadastre uma receita ou ajuste os filtros.</small></div>
    <% end %>
    <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters.except(:page), aria_label: "Paginação de receitas" %>
  </div>
</section>
