<section class="app-page health-index-page self-knowledge-page">
  <header class="app-page__hero">
    <div class="app-page__hero-top self-knowledge-section-hero">
      <div class="app-page__hero-unit app-page__hero-copy self-knowledge-section-hero__heading">
        <span class="app-page__hero-icon"><span class="material-symbols-rounded" aria-hidden="true">menu_book</span></span>
        <div><p class="app-page__eyebrow">Cadastros Básicos</p><h1 class="app-page__title">Receitas</h1></div>
      </div>
      <div class="app-page__hero-unit self-knowledge-page-actions">
        <%= link_to new_nutrition_recipe_path, class: "app-btn app-btn--primary", data: { turbo: false } do %>
          <span><span class="material-symbols-rounded" aria-hidden="true">add</span></span><span><strong>Nova Receita</strong></span>
        <% end %>
      </div>
      <div class="app-page__hero-kpis"><%= render "hero_kpis" %></div>
    </div>
  </header>
  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: nutrition_recipes_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="app-filter-field"><%= f.label :name, "Nome" %><%= f.search_field :name, value: @name_filter, class: "app-form-control", placeholder: "Buscar receita" %></div>
        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt</span> Filtrar<% end %>
          <%= link_to nutrition_recipes_path, class: "app-btn app-btn--secondary" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt_off</span> Limpar Filtros<% end %>
          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>
  <div class="app-panel app-panel--table">
    <% if @recipes.any? %>
      <div class="app-table-responsive"><table class="app-table" role="table">
        <caption class="philosophical-table__caption">Ordenar por</caption>
        <thead><tr><th scope="col"><%= sortable_table_header("Nome", :name) %></th><th scope="col"><%= sortable_table_header("Peso final (g)", :final_weight_grams) %></th><th scope="col"><%= sortable_table_header("Porções", :servings) %></th><th scope="col">Ações</th></tr></thead>
        <tbody><% @recipes.each do |recipe| %><tr>
          <td data-label="Nome"><%= link_to recipe.name, nutrition_recipe_path(recipe) %></td><td data-label="Peso final (g)"><%= taco_nutrient_value(recipe.final_weight_grams) %></td><td data-label="Porções"><%= recipe.servings %></td>
          <td data-label="Ações"><div class="writing-character-actions">
            <%= link_to nutrition_recipe_path(recipe), class: "app-btn app-btn--secondary", title: "Visualizar receita", aria: { label: "Ver #{recipe.name}" } do %><span class="material-symbols-rounded" aria-hidden="true">visibility</span> Ver<% end %>
            <%= link_to edit_nutrition_recipe_path(recipe), class: "app-btn app-btn--primary", title: "Editar receita", aria: { label: "Editar #{recipe.name}" } do %><span class="material-symbols-rounded" aria-hidden="true">edit</span> Editar<% end %>
            <%= button_to nutrition_recipe_path(recipe), method: :delete, class: "app-btn app-btn--danger", title: "Excluir receita", aria: { label: "Excluir #{recipe.name}" }, form: { data: { turbo_confirm: "Excluir #{recipe.name}? Esta ação não poderá ser desfeita." } } do %><span class="material-symbols-rounded" aria-hidden="true">delete</span> Excluir<% end %>
          </div></td>
        </tr><% end %></tbody>
      </table></div>
    <% else %>
      <div class="dashboard-empty-state"><span class="material-symbols-rounded" aria-hidden="true">menu_book</span><strong>Nenhuma receita encontrada</strong><small>Cadastre uma receita ou ajuste os filtros.</small></div>
    <% end %>
    <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters.except(:page), aria_label: "Paginação de receitas" %>
  </div>
</section>
