<% items = [["Projetos", personal_development_path], ["Oficina Filosófica", philosophical_workshop_path], ["Conceitos e Teses", philosophical_workshop_concepts_path]] %>
<% if action_name == "index" %>
  <% items[-1][1] = nil %>
<% elsif @concept.persisted? %>
  <% items << [@concept.title, action_name == "show" ? nil : philosophical_workshop_concept_path(@concept)] %>
  <% items << ["Editar", nil] if action_name.in?(%w[edit update]) %>
<% else %>
  <% items << ["Novo Conceito ou Tese", nil] %>
<% end %>
<%= render "shared/breadcrumbs", items: items %>
