<section class="app-page writing-studio writing-narrative-page">
  <%= render "breadcrumbs" %>
  <header class="app-panel writing-narrative-heading">
    <div><p class="app-page__eyebrow"><%= @concept.kind_label %></p><h1 class="app-page__title"><%= @concept.title %></h1></div>
    <div class="writing-character-actions">
      <%= link_to edit_philosophical_workshop_concept_path(@concept), class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">edit</span> Editar<% end %>
      <%= link_to philosophical_workshop_concepts_path, class: "app-btn app-btn--outline" do %><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span> Voltar<% end %>
      <%= button_to philosophical_workshop_concept_path(@concept), method: :delete, class: "app-btn app-btn--danger", form: { data: { turbo_confirm: "Excluir #{@concept.title}? Esta ação não poderá ser desfeita." } } do %><span class="material-symbols-rounded" aria-hidden="true">delete</span> Excluir<% end %>
    </div>
  </header>
  <% { description: ["Descrição", "description"], premises: ["Premissas", "lightbulb"], arguments: ["Argumentos", "forum"], personal_notes: ["Observações pessoais", "notes"] }.each do |field, (label, icon)| %>
    <section class="app-panel writing-detail">
      <h2 class="writing-detail__title"><%= writing_action_label(icon, label) %></h2>
      <div class="writing-detail__body"><%= simple_format(@concept.public_send(field).presence || "Ainda não informado.") %></div>
    </section>
  <% end %>
  <section class="app-panel writing-detail">
    <h2 class="writing-detail__title"><%= writing_action_label("person", "Filósofos associados") %></h2>
    <% associated_records = @concept.philosophers.order(:name, :id) %>
    <% if associated_records.any? %>
      <ul>
        <% associated_records.each do |record| %>
          <li><%= link_to record.name, philosophical_workshop_philosopher_path(record) %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="writing-muted">Nenhum registro associado.</p>
    <% end %>
  </section>
  <section class="app-panel"><p>Criado em <%= l(@concept.created_at.to_date) %> · Atualizado em <%= l(@concept.updated_at.to_date) %></p></section>
</section>
