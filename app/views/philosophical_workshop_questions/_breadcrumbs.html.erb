<% items = [["Projetos", personal_development_path], ["Oficina Filosófica", philosophical_workshop_path], ["Grandes Questões", philosophical_workshop_questions_path]] %>
<% if action_name == "index" %>
  <% items[-1][1] = nil %>
<% elsif @question.persisted? %>
  <% items << [truncate(@question.question, length: 60), action_name == "show" ? nil : philosophical_workshop_question_path(@question)] %>
  <% items << ["Editar", nil] if action_name.in?(%w[edit update]) %>
<% else %>
  <% items << ["Nova Questão", nil] %>
<% end %>
<%= render "shared/breadcrumbs", items: items %>
