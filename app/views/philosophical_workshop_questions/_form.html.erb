<%= form_with model: question, local: true, class: "app-form-page__form" do |f| %>
  <div class="writing-fields">
    <div class="writing-field-wide">
      <%= f.label :question, "Pergunta" %>
      <%= f.text_area :question, class: "app-form-control", rows: 7, required: true, autofocus: true, placeholder: "Qual pergunta você quer investigar?" %>
    </div>
    <div><%= f.label :context, "Contextualização" %><%= f.text_area :context, class: "app-form-control", rows: 2 %></div>
    <div><%= f.label :status, "Situação" %><%= f.select :status, PhilosophicalWorkshopQuestion::STATUSES.invert, {}, class: "app-form-select", required: true %></div>
    <div class="writing-field-wide"><%= f.label :personal_reflection, "Reflexão pessoal" %><%= f.text_area :personal_reflection, class: "app-form-control", rows: 3 %></div>
  </div>
  <div class="app-form-page__actions">
    <%= link_to "Cancelar", question.persisted? ? philosophical_workshop_question_path(question) : philosophical_workshop_questions_path, class: "app-btn app-btn--outline" %>
    <%= f.button class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">save</span> Salvar Questão<% end %>
  </div>
<% end %>
