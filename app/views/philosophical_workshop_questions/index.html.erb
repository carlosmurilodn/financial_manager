<section class="app-page writing-studio writing-narrative-page philosophical-list-page">
  <%= render "breadcrumbs" %>
  <header class="app-panel writing-narrative-heading">
    <div><p class="app-page__eyebrow">Oficina Filosófica</p><h1 class="app-page__title">Grandes Questões</h1></div>
    <%= link_to new_philosophical_workshop_question_path, class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">add</span> Nova Questão<% end %>
  </header>
  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: philosophical_workshop_questions_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <%= f.hidden_field :sort, value: @sort %>
        <%= f.hidden_field :direction, value: @direction %>
        <div class="app-filter-grid writing-narrative-filters">
          <div class="app-filter-field"><%= f.label :query, "Pesquisar" %><%= f.search_field :query, value: @query, class: "app-form-control", placeholder: "Buscar na pergunta, contextualização ou reflexão" %></div>
          <div class="app-filter-field"><%= f.label :status, "Situação" %><%= f.select :status, options_for_select(PhilosophicalWorkshopQuestion::STATUSES.invert, params[:status]), { include_blank: "Todas" }, class: "app-form-select" %></div>
        </div>
        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt</span> Filtrar<% end %>
          <%= link_to philosophical_workshop_questions_path, class: "app-btn app-btn--secondary app-page__secondary-btn" do %><span class="material-symbols-rounded" aria-hidden="true">filter_alt_off</span> Limpar Filtros<% end %>
          <div class="app-per-page-control"><%= f.label :per_page, "Exibir", class: "app-per-page-control__label" %><%= f.select :per_page, options_for_select(per_page_options, @per_page), {}, class: "form-select app-per-page-control__select", onchange: "this.form.requestSubmit()" %><span class="app-per-page-control__suffix">por página</span></div>
        </div>
      <% end %>
    <% end %>
  </div>
  <p class="writing-muted"><%= @filtered_count %> registro(s) encontrado(s)</p>
  <% if @questions.empty? %>
    <div class="app-panel writing-empty"><h2>Nenhuma questão encontrada.</h2><p>Cadastre um registro ou ajuste os filtros.</p></div>
  <% else %>
    <div class="app-panel app-panel--table">
      <div class="app-table-responsive">
        <table class="app-table" role="table">
          <caption class="philosophical-table__caption">Ordenar por</caption>
          <thead role="rowgroup"><tr role="row">
            <th scope="col" role="columnheader"><%= sortable_table_header("Pergunta", :question) %></th>
            <th scope="col" role="columnheader"><%= sortable_table_header("Situação", :status) %></th>
            <th scope="col" role="columnheader"><%= sortable_table_header("Atualizado em", :updated_at) %></th>
            <th scope="col" role="columnheader">Ações</th>
          </tr></thead>
          <tbody role="rowgroup">
            <% @questions.each do |question| %>
              <tr role="row">
                <td role="cell" data-label="Pergunta"><%= link_to truncate(question.question, length: 100), philosophical_workshop_question_path(question) %></td>
                <td role="cell" data-label="Situação"><%= question.status_label %></td>
                <td role="cell" data-label="Atualizado em"><%= l(question.updated_at.to_date) %></td>
                <td role="cell" data-label="Ações"><div class="writing-character-actions">
                  <%= link_to philosophical_workshop_question_path(question), class: "app-btn app-btn--secondary", aria: { label: "Ver #{truncate(question.question, length: 100)}" } do %><span class="material-symbols-rounded" aria-hidden="true">visibility</span> Ver<% end %>
                  <%= link_to edit_philosophical_workshop_question_path(question), class: "app-btn app-btn--primary", aria: { label: "Editar #{truncate(question.question, length: 100)}" } do %><span class="material-symbols-rounded" aria-hidden="true">edit</span> Editar<% end %>
                  <%= button_to philosophical_workshop_question_path(question), method: :delete, class: "app-btn app-btn--danger", aria: { label: "Excluir #{truncate(question.question, length: 100)}" }, form: { data: { turbo_confirm: "Excluir #{truncate(question.question, length: 100)}? Esta ação não poderá ser desfeita." } } do %><span class="material-symbols-rounded" aria-hidden="true">delete</span> Excluir<% end %>
                </div></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
  <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters %>
</section>
