<% items = [["Projetos", personal_development_path], ["Oficina Filosófica", philosophical_workshop_path], ["Meus Pensamentos", philosophical_workshop_thoughts_path]] %>
<% if action_name == "index" %>
  <% items[-1][1] = nil %>
<% elsif @thought.persisted? %>
  <% items << [@thought.title, action_name == "show" ? nil : philosophical_workshop_thought_path(@thought)] %>
  <% items << ["Editar", nil] if action_name.in?(%w[edit update]) %>
<% else %>
  <% items << ["Novo Pensamento", nil] %>
<% end %>
<%= render "shared/breadcrumbs", items: items %>
