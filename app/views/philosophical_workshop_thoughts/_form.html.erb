<%= form_with model: thought, local: true, class: "app-form-page__form" do |f| %>
  <% if thought.new_record? && thought.source_insight %>
    <%= hidden_field_tag :source_insight_id, thought.source_insight_id %>
    <p class="writing-muted">Origem: <%= link_to "Insight", philosophical_workshop_insight_path(thought.source_insight) %></p>
  <% end %>
  <fieldset class="writing-form-section">
    <legend>Identificação</legend>
    <div class="writing-fields">
      <div><%= f.label :title, "Título" %><%= f.text_field :title, class: "app-form-control", required: true, maxlength: 200 %></div>
      <div><%= f.label :kind, "Tipo" %><%= f.select :kind, PhilosophicalWorkshopThought::KINDS.invert, {}, class: "app-form-select", required: true %></div>
      <div><%= f.label :status, "Situação" %><%= f.select :status, PhilosophicalWorkshopThought::STATUSES.invert, {}, class: "app-form-select", required: true %></div>
    </div>
  </fieldset>
  <fieldset class="writing-form-section">
    <legend>Conteúdo e reflexões</legend>
    <div class="writing-fields">
      <% { central_idea: "Ideia central", supporting_arguments: "Argumentos favoráveis", counterpoints: "Contrapontos", provisional_conclusion: "Conclusão provisória" }.each do |field, label| %>
        <div class="writing-field-wide"><%= f.label field, label %><%= f.text_area field, class: "app-form-control", rows: 5, required: field == :central_idea %></div>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="writing-form-section" data-controller="select2">
    <legend>Grandes Questões associadas</legend>
    <%= f.label :question_ids, "Questões" %>
    <%= f.collection_select :question_ids, @questions, :id, :question, {}, multiple: true, class: "app-form-select", data: { placeholder: "Pesquisar e selecionar…" } %>
    <% if @questions.empty? %><p class="writing-muted">Nenhuma questão cadastrada.</p><% end %>
  </fieldset>
  <div class="app-form-page__actions">
    <%= link_to writing_action_label("close", "Cancelar"), thought.persisted? ? philosophical_workshop_thought_path(thought) : philosophical_workshop_thoughts_path, class: "app-btn app-btn--outline" %>
    <%= f.button class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">save</span> Salvar<% end %>
  </div>
<% end %>
