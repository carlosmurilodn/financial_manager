<section class="app-page writing-studio writing-narrative-page">
  <%= render "breadcrumbs" %>
  <header class="app-panel writing-narrative-heading">
    <div><p class="app-page__eyebrow"><%= @thought.kind_label %> · <%= @thought.status_label %></p><h1 class="app-page__title"><%= @thought.title %></h1></div>
    <div class="writing-character-actions">
      <%= link_to edit_philosophical_workshop_thought_path(@thought), class: "app-btn app-btn--primary" do %><span class="material-symbols-rounded" aria-hidden="true">edit</span> Editar<% end %>
      <%= link_to philosophical_workshop_thoughts_path, class: "app-btn app-btn--outline" do %><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span> Voltar<% end %>
      <%= button_to philosophical_workshop_thought_path(@thought), method: :delete, class: "app-btn app-btn--danger", form: { data: { turbo_confirm: "Excluir #{@thought.title}? Esta ação não poderá ser desfeita." } } do %><span class="material-symbols-rounded" aria-hidden="true">delete</span> Excluir<% end %>
    </div>
  </header>
  <% { central_idea: "Ideia central", supporting_arguments: "Argumentos favoráveis", counterpoints: "Contrapontos", provisional_conclusion: "Conclusão provisória" }.each do |field, label| %>
    <section class="app-panel writing-detail">
      <h2 class="writing-detail__title"><%= label %></h2>
      <div class="writing-detail__body"><%= simple_format(@thought.public_send(field).presence || "Ainda não informado.") %></div>
    </section>
  <% end %>
  <section class="app-panel"><p>Criado em <%= l(@thought.created_at.to_date) %> · Atualizado em <%= l(@thought.updated_at.to_date) %></p></section>
</section>
