<% prefix = "exercise-#{type}-#{day.occurred_on.iso8601}" %>
<article class="exercise-day-card" id="<%= prefix %>" aria-label="<%= exercise_categories.fetch(type) %> em <%= day.occurred_on.strftime('%d/%m/%Y') %>">
  <% if day.errors.any? %>
    <div class="exercise-day-card__errors" role="alert">
      <% day.errors.full_messages.each do |message| %><p><%= message %></p><% end %>
    </div>
  <% end %>
  <%= form_with scope: :exercise_day, url: toggle_health_exercise_day_path(@week_start.iso8601), method: :patch, html: { id: "#{prefix}-form", class: "exercise-day-card__form" } do |f| %>
    <%= hidden_field_tag :occurred_on, day.occurred_on.iso8601, id: "#{prefix}-date" %>
    <%= hidden_field_tag :activity, type, id: "#{prefix}-activity" %>
    <%= f.hidden_field :exercise_status, value: day.errors.any? ? day.exercise_status : day.exercise_day_status, id: "#{prefix}-status" %>
    <%= f.label :duration_minutes, "Duração (min)", for: "#{prefix}-duration" %>
    <%= f.number_field :duration_minutes, value: day.duration_minutes_before_type_cast, min: 0.01, max: 1440, step: 0.01, id: "#{prefix}-duration", class: "app-form-control", placeholder: "Opcional" %>
    <% if type == 'walking' %>
      <%= f.label :distance_km, "Distância (km)", for: "#{prefix}-distance" %>
      <%= f.number_field :distance_km, value: day.distance_km_before_type_cast, min: 0.01, max: 9999.99, step: 0.01, id: "#{prefix}-distance", class: "app-form-control", placeholder: "Opcional" %>
      <%= f.label :steps, "Passos", for: "#{prefix}-steps" %>
      <%= f.number_field :steps, value: day.steps_before_type_cast, min: 0, max: 1000000, step: 1, id: "#{prefix}-steps", class: "app-form-control", placeholder: "Opcional" %>
    <% else %>
      <% if type == 'training' %>
        <%= f.label :muscle_groups, "Grupos Musculares", for: "#{prefix}-groups" %>
        <%= f.text_field :muscle_groups, value: day.muscle_groups, maxlength: 150, id: "#{prefix}-groups", class: "app-form-control", placeholder: "Ex.: Peito e tríceps" %>
      <% else %>
        <%= f.label :exercise_focus, "Foco do Treino", for: "#{prefix}-focus" %>
        <%= f.select :exercise_focus, options_for_select(WeeklyHealthGoalDay::EXERCISE_FOCUSES, day.exercise_focus), {}, id: "#{prefix}-focus", class: "app-form-select" %>
      <% end %>
      <%= f.label :exercise_intensity, "Intensidade", for: "#{prefix}-intensity" %>
      <%= f.select :exercise_intensity, options_for_select(WeeklyHealthGoalDay::EXERCISE_INTENSITIES, day.exercise_intensity), {}, id: "#{prefix}-intensity", class: "app-form-select" %>
    <% end %>
    <%= f.submit "Salvar", class: "app-btn app-btn--primary" %>
  <% end %>
  <% if type == 'walking' %>
    <p class="exercise-day-card__pace">Ritmo médio: <strong><%= day.walking_pace ? "#{day.walking_pace} min/km" : 'Sem registro' %></strong></p>
  <% end %>
  <small class="exercise-day-card__saved"><%= day.persisted? && day.errors.empty? ? 'Registro salvo ✅' : 'Sem registro salvo' %></small>
</article>
