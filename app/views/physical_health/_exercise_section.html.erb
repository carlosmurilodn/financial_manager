<% days_by_date = goal.weekly_health_goal_days.index_by(&:occurred_on) %>
<section class="weekly-health-plan-days__goal exercise-section">
  <div class="weekly-health-plan-days__goal-header">
    <strong><%= label %></strong>
    <span id="exercise-<%= goal.id %>-count"><%= goal.completed_count %> / <%= goal.target_count %></span>
  </div>
  <div class="weekly-health-plan-days__week">
    <% ["Segunda-Feira", "Terça-Feira", "Quarta-Feira", "Quinta-Feira", "Sexta-Feira", "Sábado", "Domingo"].each_with_index do |weekday, index| %>
      <% date = @week_start + index.days %>
      <% day = days_by_date[date] %>
      <% prefix = "exercise-#{type}-#{date.iso8601}" %>
      <%= form_with url: toggle_health_exercise_day_path(@week_start.iso8601), method: :patch, html: { class: "exercise-calendar-form" }, data: { controller: "exercise-calendar", action: "submit->exercise-calendar#toggle", exercise_calendar_form_id_value: "#{prefix}-form" } do %>
        <%= hidden_field_tag :occurred_on, date.iso8601, id: "#{prefix}-calendar-date" %>
        <%= hidden_field_tag :activity, type, id: "#{prefix}-calendar-activity" %>
        <%= render "exercise_calendar_day", day: day, date: date, type: type, label: label %>
      <% end %>
    <% end %>
  </div>
  <%= render "exercise_summary", goal: goal, type: type %>
  <div class="exercise-day-grid">
    <% 7.times do |index| %>
      <% date = @week_start + index.days %>
      <% day = days_by_date[date] || goal.weekly_health_goal_days.build(occurred_on: date) %>
      <% if @invalid_exercise_day&.weekly_health_goal_id == goal.id && @invalid_exercise_day.occurred_on == date %>
        <% day = @invalid_exercise_day %>
      <% end %>
      <%= render "exercise_day", day: day, type: type %>
    <% end %>
  </div>
</section>
