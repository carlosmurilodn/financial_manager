<section class="app-page health-index-page nutrition-page self-knowledge-page">
  <%= render "hero" %>
  <%= render "week_filters" %>
  <% @weeks.each do |week| %>

    <article class="health-card weekly-health-plan-card nutrition-week-card" style="--health-card-accent: #5c6df2;">
      <div class="health-card__content"><div class="health-card__summary nutrition-week-card__summary">
        <div class="health-card__identity-block"><%= link_to health_exercise_week_path(week.iso8601), class: "health-card__identity-main", data: { turbo: false } do %><div class="health-card__icon-wrapper"><span class="material-symbols-rounded health-card__icon">fitness_center</span></div><h2 class="health-card__title">Semana de <%= week.strftime('%d/%m/%Y') %> a <%= (week + 6.days).strftime('%d/%m/%Y') %></h2><% end %></div>
        <div class="health-card__information nutrition-week-card__metrics">
          <% exercise_categories.each do |type, label| %>
            <% goal = exercise_goal(@plans_by_week[week], type); next unless goal %>
            <span class="nutrition-week-card__metric"><span class="material-symbols-rounded"><%= type == "walking" ? "directions_walk" : "fitness_center" %></span><span><small><%= label %></small><strong><%= goal.completed_count %> / <%= goal.target_count %> dias</strong></span></span>
          <% end %>
        </div>
        <div class="health-card__actions"><%= link_to edit_health_exercise_week_path(week.iso8601), class: "health-card__action", data: { turbo: false } do %><span class="material-symbols-rounded">edit</span><span class="health-card__action-label">Editar</span><% end %><%= link_to health_exercise_week_path(week.iso8601), class: "health-card__action health-card__action--danger", data: { turbo_method: :delete, turbo_confirm: "Excluir as categorias e marcações de exercícios desta semana? As calorias serão preservadas e recalculadas." } do %><span class="material-symbols-rounded">delete</span><span class="health-card__action-label">Excluir</span><% end %></div>
      </div></div>
    </article>
  <% end %>
  <% if @weeks.empty? %><div class="app-panel"><p>Nenhuma semana neste período.</p></div><% end %>
  <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters.except(:page) %>
</section>
