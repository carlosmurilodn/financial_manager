<section class="app-page weekly-health-plan-show">
  <div class="app-page__hero"><div class="weekly-health-plan-show__header"><div class="app-page__hero-copy"><span class="app-page__hero-icon"><span class="material-symbols-rounded">fitness_center</span></span><div><p class="app-page__eyebrow">Saúde Física</p><h1 class="app-page__title">Exercícios</h1><p class="app-page__description">Semana de <%= @week_start.strftime('%d/%m/%Y') %> a <%= (@week_start + 6.days).strftime('%d/%m/%Y') %></p></div></div><%= link_to "Editar Semana", edit_health_exercise_week_path(@week_start.iso8601), class: "app-btn app-btn--primary", data: { turbo: false } %><%= link_to "Excluir Semana", health_exercise_week_path(@week_start.iso8601), class: "app-btn app-btn--danger", data: { turbo_method: :delete, turbo_confirm: "Excluir as categorias e marcações de exercícios desta semana? As calorias serão preservadas e recalculadas." } %><%= link_to "Voltar às Semanas", health_exercise_path, class: "app-btn app-btn--outline", data: { turbo: false } %></div></div>
  <article class="health-card weekly-health-plan-card" style="--health-card-accent: #5c6df2;"><div class="health-card__content">
    <div class="weekly-health-plan-days exercise-week-calendars">
      <% exercise_categories.each do |type, label| %>
        <% goal = exercise_goal(@plan, type) %>
        <% next unless goal %>
        <div class="weekly-health-plan-days__goal">
          <div class="weekly-health-plan-days__goal-header"><strong><%= label %></strong><span><%= goal&.completed_count || 0 %> / <%= goal&.target_count || 3 %></span></div>
          <div class="weekly-health-plan-days__week">
            <% %w[Seg Ter Qua Qui Sex Sáb Dom].each_with_index do |weekday, index| %>
              <% date = @week_start + index.days; completed = goal&.completed_on?(date) %>
              <%= button_to toggle_health_exercise_day_path(@week_start.iso8601, occurred_on: date.iso8601, activity: type), method: :patch, class: "weekly-health-plan-days__day #{'is-checked' if completed}", form: { class: "weekly-health-plan-days__day-form" }, aria: { label: "#{completed ? 'Desmarcar' : 'Marcar'} #{label} em #{date.strftime('%d/%m/%Y')}" } do %>
                <span><%= weekday %></span><strong><%= date.strftime('%d') %></strong><span class="material-symbols-rounded" aria-hidden="true"><%= completed ? 'check' : 'close' %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% unless exercise_categories.keys.any? { |type| exercise_goal(@plan, type) } %>
      <p>Nenhuma categoria de exercício cadastrada nesta semana.</p><%= link_to "Selecionar Categorias", new_health_exercise_week_path, class: "app-btn app-btn--primary" %>
    <% end %>
  </div></article>
</section>
