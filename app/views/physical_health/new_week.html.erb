<section class="app-page app-form-page">
  <div class="app-page__hero"><div class="app-page__hero-copy"><span class="app-page__hero-icon"><span class="material-symbols-rounded">calendar_month</span></span><div><p class="app-page__eyebrow">Saúde Física · Alimentação</p><h1 class="app-page__title"><%= @editing ? "Editar Semana" : "Nova Semana" %></h1></div></div></div>
  <div class="app-panel">
    <p>Calendário fixo de alimentação e calorias para os sete dias.</p>
    <% form_url = @editing ? health_nutrition_week_path(@selected_week) : health_nutrition_path %>
    <%= form_with url: form_url, method: @editing ? :patch : :post, local: true, data: { turbo: false }, class: "app-filter-form" do |f| %>
      <% year = Date.current.cwyear; options = (1..Date.new(year, 12, 28).cweek).map { |number| start = Date.commercial(year, number, 1); ["Semana #{number} · #{start.strftime('%d/%m/%Y')} a #{(start + 6.days).strftime('%d/%m/%Y')}", start.iso8601] } %>
      <% if @editing %>
        <p><strong>Semana de <%= @week_start.strftime('%d/%m/%Y') %> a <%= (@week_start + 6.days).strftime('%d/%m/%Y') %></strong></p>
        <div class="app-filter-field"><%= label_tag :notes, "Observações da Semana" %><%= text_area_tag :notes, params[:notes] || @nutrition_goal&.notes, class: "app-form-control", maxlength: 500 %></div>
      <% else %>
      <div class="app-filter-field"><%= f.label :week_start, "Semana" %><%= f.select :week_start, options_for_select(options, @selected_week), {}, class: "app-form-select", required: true %></div>
      <% end %>
      <div class="app-filter-actions"><%= f.submit @editing ? "Salvar Alterações" : "Criar Semana", class: "app-btn app-btn--primary" %><%= link_to "Voltar", health_nutrition_path, class: "app-btn app-btn--outline" %></div>
    <% end %>
  </div>
</section>
