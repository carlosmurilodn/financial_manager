<section class="app-page health-index-page nutrition-page self-knowledge-page">
  <%= render "hero" %>
  <div class="app-filter-actions"><%= link_to "Sincronizar GitHub", health_data_github_sync_path, class: "app-btn app-btn--outline" %></div>
  <%= render "week_filters" %>
  <div class="app-panel app-panel--table">
    <% if @weeks.any? %>
      <div class="health-weight-goal-list">
        <% @weeks.each do |week| %><%= render "nutrition_week_card", week: week %><% end %>
      </div>
    <% else %>
      <div class="dashboard-empty-state"><span class="material-symbols-rounded" aria-hidden="true">restaurant</span><strong>Nenhuma semana encontrada</strong><small>Ajuste os filtros ou cadastre uma nova semana.</small></div>
    <% end %>
    <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters.except(:page) %>
  </div>
</section>
