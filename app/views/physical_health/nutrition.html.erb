<section class="app-page health-index-page nutrition-page self-knowledge-page">
  <%= render "hero" %>
  <%= render "week_filters" %>
  <% @weeks.each do |week| %>
    <% goal = @plans_by_week[week]&.weekly_health_goals&.find { |item| item.name.parameterize == "alimentacao" }; completed = goal&.completed_count || 0 %>
    <article class="health-card weekly-health-plan-card nutrition-week-card" style="--health-card-accent: #5c6df2;">
      <div class="health-card__content"><div class="health-card__summary nutrition-week-card__summary">
        <div class="health-card__identity-block"><%= link_to health_nutrition_week_path(week.iso8601), class: "health-card__identity-main", data: { turbo: false } do %><div class="health-card__icon-wrapper"><span class="material-symbols-rounded health-card__icon">restaurant</span></div><h2 class="health-card__title">Semana de <%= week.strftime('%d/%m/%Y') %> a <%= (week + 6.days).strftime('%d/%m/%Y') %></h2><% end %></div>
        <div class="health-card__information nutrition-week-card__metrics"><span class="nutrition-week-card__metric"><span class="material-symbols-rounded">task_alt</span><span><small>Alimentação</small><strong><%= completed %> / 7 dias</strong></span></span><span class="nutrition-week-card__metric"><span class="material-symbols-rounded">local_fire_department</span><span><small>Calorias Preenchidas</small><strong><%= @calorie_counts[week] || 0 %> / 7 dias</strong></span></span></div>
        <div class="health-card__actions"><%= link_to "Ver Semana", health_nutrition_week_path(week.iso8601), class: "health-card__action", data: { turbo: false } %><%= link_to "Editar", edit_health_nutrition_week_path(week.iso8601), class: "health-card__action", data: { turbo: false } %><%= link_to "Excluir", health_nutrition_week_path(week.iso8601), class: "health-card__action health-card__action--danger", data: { turbo_method: :delete, turbo_confirm: "Excluir os registros de alimentação e calorias desta semana?" } %></div>
        <div class="nutrition-week-card__averages">
          <% { consumed: ["Calorias Ingeridas Médias", "restaurant", "blue"], expenditure: ["Gasto Estimado Médio", "local_fire_department", "red"], deficit: ["Déficit Médio", "balance", "green"] }.each do |metric, (label, icon, color)| %>
            <% average = @calorie_summaries.fetch(week).fetch(metric) %>
            <% label = "Superávit Médio" if metric == :deficit && average[:mean]&.negative? %>
            <div class="self-knowledge-hero-kpi self-knowledge-hero-kpi--<%= color %>">
              <span class="material-symbols-rounded" aria-hidden="true"><%= icon %></span>
              <div>
                <p><%= label %></p>
                <strong><%= average[:mean] ? "#{number_with_precision(average[:mean].abs, precision: 0, delimiter: '.')} kcal" : "Sem registro" %></strong>
              </div>
            </div>
          <% end %>
        </div>
      </div></div>
    </article>
  <% end %>
  <% if @weeks.empty? %><div class="app-panel"><p>Nenhuma semana neste período.</p></div><% end %>
  <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters.except(:page) %>
</section>
