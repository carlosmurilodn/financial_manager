<% summary = @physical_progress[:summary] %>
<% explanation = "Consumo calculado pelas refeições. Médias consideram apenas dias com dados. Gasto estimado já inclui o fator das atividades; exercícios não são somados novamente. Evolução do peso: última medição menos primeira na semana." %>
<article class="app-panel progress-panel progress-physical-summary">
  <div class="progress-history__header">
    <div class="progress-physical-summary__heading">
      <div class="progress-panel__header"><span class="material-symbols-rounded" aria-hidden="true">monitoring</span><div><p class="app-page__eyebrow">Saúde Física · Semana selecionada</p><h2>Alimentação, peso e exercícios</h2></div></div>
      <div class="progress-physical-summary__badges">
        <% { consumed: ["Consumo da Semana", "calories"], bmr: ["Basal médio", "fats"], tdee: ["Gasto médio", "proteins"], deficit: [summary[:deficit][:mean]&.negative? ? "Superávit médio" : "Déficit médio", "carbohydrates"] }.each do |field, (label, color)| %>
          <% value = field == :consumed ? summary[field][:total] : summary[field][:mean]&.abs %>
          <span class="nutrition-recipe-result__badge nutrition-recipe-result__badge--<%= color %>" title="<%= summary[field][:count] %> / 7 dias com dados"><%= label %>: <%= progress_metric(value) %></span>
        <% end %>
        <span class="nutrition-recipe-result__badge progress-physical-summary__weight" title="<%= summary[:weight_count] %> medições na semana">Variação do peso: <%= progress_metric(summary[:weight_change], unit: "kg", signed: true) %></span>
        <span class="material-symbols-rounded progress-physical-summary__info" tabindex="0" role="img" title="<%= explanation %>" aria-label="<%= explanation %>">info</span>
      </div>
    </div>
  </div>
  <div class="progress-physical-table-wrap" role="region" aria-label="Indicadores diários da semana" tabindex="0">
    <table class="progress-physical-table">
      <thead>
        <tr><th scope="col">Dia</th><th scope="col">Consumo</th><th scope="col">Basal estimado</th><th scope="col">Gasto estimado</th><th scope="col">Déficit / Superávit</th><th scope="col">Peso</th><th scope="col">Atividades</th></tr>
      </thead>
      <tbody>
        <% @physical_progress[:days].each do |day| %>
          <% has_data = %i[consumed bmr tdee deficit weight].any? { |field| !day[field].nil? } || day[:activities].present? %>
          <tr>
            <th scope="row"><span><%= %w[Domingo Segunda-feira Terça-feira Quarta-feira Quinta-feira Sexta-feira Sábado][day[:date].wday] %></span><time datetime="<%= day[:date].iso8601 %>"><%= day[:date].strftime("%d/%m") %></time></th>
            <% if has_data %>
              <% { consumed: "calories", bmr: "fats", tdee: "proteins", deficit: "carbohydrates", weight: "weight" }.each do |field, color| %>
                <td class="progress-physical-table__number">
                  <% if day[field].nil? %>
                    <span class="progress-physical-table__empty">Sem dados</span>
                  <% else %>
                    <span class="progress-physical-table__value progress-physical-table__value--<%= color %>"><%= "Superávit · " if field == :deficit && day[field].negative? %><%= progress_metric(field == :deficit ? day[field].abs : day[field], unit: field == :weight ? "kg" : "kcal") %></span>
                  <% end %>
                  <% if field == :bmr && day[:reference_weight_date] && day[:reference_weight_date] != day[:date] %><span class="material-symbols-rounded progress-physical-summary__info" tabindex="0" role="img" title="Estimativas usam pesagem de <%= day[:reference_weight_date].strftime("%d/%m/%Y") %>." aria-label="Estimativas usam pesagem de <%= day[:reference_weight_date].strftime("%d/%m/%Y") %>.">info</span><% end %>
                </td>
              <% end %>
              <td><span class="<%= "progress-physical-table__empty" if day[:activities].blank? %>"><%= day[:activities].presence&.join(" · ") || "Sem dados" %></span><%= " · #{day[:duration]} min" if day[:duration] %></td>
            <% else %>
              <td colspan="6" class="progress-physical-table__empty">Sem dados</td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>
