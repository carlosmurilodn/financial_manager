<% summary = @physical_progress[:summary] %>
<article class="app-panel progress-panel">
  <div class="progress-history__header">
    <div class="progress-panel__header"><span class="material-symbols-rounded" aria-hidden="true">monitoring</span><div><p class="app-page__eyebrow">Saúde Física · Semana selecionada</p><h2>Alimentação, peso e exercícios</h2></div></div>
    <div class="nutrition-recipe-actions"><%= link_to "Alimentação", health_nutrition_path, class: "app-btn app-btn--outline", data: { turbo: false } %><%= link_to "Balança", weight_entries_path, class: "app-btn app-btn--outline", data: { turbo: false } %><%= link_to "Exercícios", health_exercises_path, class: "app-btn app-btn--outline", data: { turbo: false } %></div>
  </div>
  <div class="progress-physical-kpis">
    <% { consumed: ["Calorias consumidas", "restaurant", "blue"], bmr: ["Metabolismo basal médio", "local_fire_department", "yellow"], tdee: ["Gasto diário médio", "fitness_center", "red"], deficit: [summary[:deficit][:mean]&.negative? ? "Superávit médio" : "Déficit médio", "balance", "green"] }.each do |field, (label, icon, color)| %>
      <% value = field == :consumed ? summary[field][:total] : summary[field][:mean]&.abs %>
      <article class="self-knowledge-hero-kpi self-knowledge-hero-kpi--<%= color %>"><span class="material-symbols-rounded" aria-hidden="true"><%= icon %></span><div><p><%= label %></p><strong><%= progress_metric(value) %></strong><small><%= summary[field][:count] %> / 7 dias com dados</small></div></article>
    <% end %>
    <article class="self-knowledge-hero-kpi self-knowledge-hero-kpi--purple"><span class="material-symbols-rounded" aria-hidden="true">monitor_weight</span><div><p>Evolução do peso</p><strong><%= progress_metric(summary[:weight_change], unit: "kg", signed: true) %></strong><small><%= summary[:weight_count] %> medições na semana; última menos primeira</small></div></article>
  </div>
  <p class="progress-empty">Consumo vem das refeições; registros antigos são usados apenas em dias sem itens. Médias consideram somente dias com dados. O gasto estimado já inclui o fator das atividades registradas, sem adicionar exercícios novamente.</p>
  <div class="nutrition-cards">
    <% @physical_progress[:days].each do |day| %>
      <article class="health-card progress-physical-day" style="--health-card-accent: #5c6df2;">
        <div class="health-card__content">
          <header class="progress-history__header"><h3><%= %w[Domingo Segunda-feira Terça-feira Quarta-feira Quinta-feira Sexta-feira Sábado][day[:date].wday] %> · <%= day[:date].strftime("%d/%m") %></h3><small class="progress-empty"><%= { meals: "Refeições registradas", legacy: "Registro anterior de calorias", none: "Sem dados de alimentação" }[day[:source]] %></small></header>
          <dl class="progress-physical-day__metrics">
            <div><dt>Calorias consumidas</dt><dd><%= progress_metric(day[:consumed]) %></dd></div>
            <div><dt>Basal estimado</dt><dd><%= progress_metric(day[:bmr]) %></dd></div>
            <div><dt>Gasto diário estimado</dt><dd><%= progress_metric(day[:tdee]) %></dd></div>
            <div><dt><%= day[:deficit]&.negative? ? "Superávit" : "Déficit" %></dt><dd><%= progress_metric(day[:deficit]&.abs) %></dd></div>
            <div><dt>Peso registrado</dt><dd><%= progress_metric(day[:weight], unit: "kg") %></dd></div>
            <div><dt>Atividades realizadas</dt><dd><%= day[:activities].presence&.join(" · ") || "Sem dados" %><%= " · #{day[:duration]} min" if day[:duration] %></dd></div>
          </dl>
          <% if day[:reference_weight_date] && day[:reference_weight_date] != day[:date] %><p class="progress-empty">Estimativas usam pesagem de <%= day[:reference_weight_date].strftime("%d/%m/%Y") %>.</p><% end %>
        </div>
      </article>
    <% end %>
  </div>
</article>
