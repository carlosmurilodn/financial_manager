<article class="app-panel progress-panel progress-mental-panel">
  <div class="progress-panel__header"><span class="material-symbols-rounded">psychology_alt</span><div><p class="app-page__eyebrow">Semana selecionada</p><h2>Saúde Mental</h2></div></div>
  <div class="progress-mental-kpis">
    <% Health::SelfKnowledgeContent::METRICS.each_with_index do |(field, _), index| %>
      <% average = @self_knowledge_week.averages.fetch(field) %>
      <div class="self-knowledge-hero-kpi self-knowledge-hero-kpi--<%= mental_score_color(average[:mean]) %>">
        <span class="material-symbols-rounded" aria-hidden="true"><%= %w[sentiment_satisfied bolt psychology][index] %></span>
        <div>
          <p><%= { mood: "Humor Médio", energy: "Energia Média", tension: "Tensão Média" }.fetch(field) %></p>
          <strong><%= average[:mean] ? "#{number_with_precision(average[:mean], precision: 1, separator: ',')} / 5" : "Sem registro" %></strong>
          <small><%= pluralize(average[:count], "resposta diária", "respostas diárias") %></small>
        </div>
      </div>
    <% end %>
  </div>
  <% diaries = @self_knowledge_week.days.index_by(&:entry_date) %>
  <div class="progress-diary-days" aria-label="Diários da semana">
    <% %w[Seg Ter Qua Qui Sex Sáb Dom].each_with_index do |label, index| %>
      <% day = @week_start + index.days; diary = diaries[day] %>
      <%= link_to diary ? health_journal_entry_path(diary) : new_health_journal_entry_path(date: day.iso8601), class: "progress-diary-day #{'is-done' if diary}", data: { turbo_frame: "_top" }, aria: { label: "#{label}, #{day.strftime('%d/%m/%Y')}: #{diary ? 'ver diário' : 'sem registro, registrar diário'}" } do %>
        <span><%= label %></span><strong><%= day.strftime('%d') %></strong><span class="material-symbols-rounded" aria-hidden="true"><%= diary ? 'check' : 'edit_note' %></span>
      <% end %>
    <% end %>
  </div>
  <% if @self_knowledge_reflection %>
    <% { weekly_learning: "Aprendizado da Semana", next_small_step: "Próximo Pequeno Passo" }.each do |field, label| %>
      <% value = @self_knowledge_reflection.public_send(field) %>
      <% if value.present? %><div class="progress-week-reflection"><strong><%= label %></strong><%= simple_format(value) %></div><% end %>
    <% end %>
  <% end %>
  <div class="app-form-page__actions"><%= link_to "Registrar hoje", new_health_journal_entry_path, class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %><%= link_to "Revisar semana", @self_knowledge_reflection ? edit_health_weekly_reflection_path(@self_knowledge_reflection) : new_health_weekly_reflection_path(date: @week_start.iso8601), class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %><%= link_to "Autoconhecimento", self_knowledge_evolution_path, class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %></div>
</article>
