<article id="metas-processo" class="app-panel progress-panel">
  <div class="progress-history__header">
    <div class="progress-panel__header"><span class="material-symbols-rounded">task_alt</span><div><p class="app-page__eyebrow">Saúde Física</p><h2>Realizado na Semana</h2></div></div>
    <div class="progress-physical-links">
      <%= link_to "Alimentação", health_nutrition_week_path(@week_start.iso8601), class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
      <%= link_to "Exercícios", health_exercises_path, class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
    </div>
  </div>
  <% if @saved_weekly_goals.any? %>
    <div class="progress-activity-scroll" tabindex="0" role="region" aria-label="Realizado por meta e dia da semana">
      <table class="progress-activity-table">
        <thead><tr><th scope="col">Meta</th><% %w[Seg Ter Qua Qui Sex Sáb Dom].each_with_index do |label, index| %><th scope="col"><%= label %><small><%= (@week_start + index.days).strftime("%d/%m") %></small></th><% end %><th scope="col">Realizado<br>/ Planejado</th></tr></thead>
        <tbody>
          <% @physical_week_rows.each do |row| %>
            <% goal = row[:goal] %>
            <tr>
              <th scope="row"><%= row[:label] %></th>
              <% row[:days].each do |day| %>
                <% status = progress_activity_status(day[:state]) %>
                <td><span class="progress-activity-day <%= status[:css] %>" role="img" aria-label="<%= status[:label] %>" title="<%= status[:label] %> em <%= day[:date].strftime('%d/%m/%Y') %>"><span class="material-symbols-rounded" aria-hidden="true"><%= status[:icon] %></span></span></td>
              <% end %>
              <td title="<%= row[:type] == 'nutrition' ? 'Dias de dieta totalmente seguida / planejados' : 'Dias realizados / planejados' %>"><strong><%= row[:completed_count] %> / <%= goal.target_count %></strong><% if row[:completed_count] >= goal.target_count %><small class="progress-activity-complete">Meta cumprida</small><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="progress-empty">Nenhuma categoria cadastrada nesta semana. Crie a semana em Alimentação ou Exercícios.</p>
  <% end %>
</article>
