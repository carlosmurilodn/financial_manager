<article id="metas-processo" class="app-panel progress-panel">
  <div class="progress-history__header">
    <div class="progress-panel__header"><span class="material-symbols-rounded">task_alt</span><div><p class="app-page__eyebrow">Saúde Física</p><h2>Realizado na Semana</h2></div></div>
    <%= link_to @weekly_health_plan.persisted? ? "Atualizar Metas" : "Planejar Semana", edit_weekly_health_plan_path(@week_start.iso8601), class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
  </div>
  <% if @saved_weekly_goals.any? %>
    <p class="progress-empty">Dias marcados como realizados. A meta indica a quantidade planejada para a semana.</p>
    <div class="progress-activity-scroll" tabindex="0" role="region" aria-label="Realizado por meta e dia da semana">
      <table class="progress-activity-table">
        <thead><tr><th scope="col">Meta</th><% %w[Seg Ter Qua Qui Sex Sáb Dom].each_with_index do |label, index| %><th scope="col"><%= label %><small><%= (@week_start + index.days).strftime("%d/%m") %></small></th><% end %><th scope="col">Realizado<br>/ Planejado</th></tr></thead>
        <tbody>
          <% @saved_weekly_goals.each do |goal| %>
            <tr>
              <th scope="row"><%= goal.name %><% if goal.notes.present? %><small><%= goal.notes %></small><% end %></th>
              <% (0..6).each do |index| %>
                <% day = @week_start + index.days; completed = goal.completed_on?(day) %>
                <td><span class="progress-activity-day <%= 'is-done' if completed %>" role="img" aria-label="<%= completed ? 'Realizado' : 'Sem registro' %>" title="<%= completed ? 'Realizado' : 'Sem registro' %> em <%= day.strftime('%d/%m/%Y') %>"><span class="material-symbols-rounded" aria-hidden="true"><%= completed ? 'check' : 'remove' %></span></span></td>
              <% end %>
              <td><strong><%= goal.completed_count %> / <%= goal.target_count %></strong><% if goal.completed_count >= goal.target_count %><small class="progress-activity-complete">Meta cumprida</small><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="progress-empty">✓ Realizado · — Sem registro diário. Totais antigos podem não ter datas detalhadas.</p>
  <% else %>
    <p class="progress-empty">Nenhuma meta salva nesta semana. Planeje a semana para acompanhar o realizado.</p>
  <% end %>
</article>
