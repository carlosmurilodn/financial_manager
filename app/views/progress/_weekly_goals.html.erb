  <article class="app-panel progress-panel">
    <div class="progress-history__header">
      <div class="progress-panel__header">
        <span class="material-symbols-rounded">task_alt</span>
        <div>
          <p class="app-page__eyebrow">Semana · segunda a domingo</p>
          <h2>Metas que dependem de você</h2>
        </div>
      </div>
      <%= link_to "Editar metas", edit_weekly_health_plan_path(@week_start.iso8601), class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
    </div>

    <div class="dashboard-card__pill dashboard-card__pill--period dashboard-card__pill--period-full progress-week-period">
      <%= link_to progress_path(week: (@week_start - 7.days).iso8601), class: "dashboard-card__period-button", aria: { label: "Semana anterior" }, data: { turbo_frame: "progress-weekly-goals", turbo_prefetch: false } do %>
        <span class="material-symbols-rounded">chevron_left</span>
      <% end %>
      <span class="dashboard-card__period-label">
        <span class="material-symbols-rounded">date_range</span>
        <span><%= @week_start.strftime("%d/%m/%Y") %> a <%= @weekly_health_plan.week_end.strftime("%d/%m/%Y") %></span>
      </span>
      <%= link_to progress_path(week: (@week_start + 7.days).iso8601), class: "dashboard-card__period-button", aria: { label: "Próxima semana" }, data: { turbo_frame: "progress-weekly-goals", turbo_prefetch: false } do %>
        <span class="material-symbols-rounded">chevron_right</span>
      <% end %>
    </div>

    <% if @week_start == Date.current.beginning_of_week(:monday) %>
      <p class="progress-empty">Semana Atual</p>
    <% else %>
      <%= link_to "Voltar à Semana Atual", progress_path, class: "progress-week-current", data: { turbo_frame: "progress-weekly-goals", turbo_prefetch: false } %>
    <% end %>

    <% unless @weekly_health_plan.persisted? %>
      <p class="progress-empty">Planejamento sugerido, ainda não salvo. Ajuste as Metas e registre o realizado em “Editar Metas”.</p>
    <% end %>

    <ul class="progress-week-goals">
      <% @weekly_health_plan.weekly_health_goals.each do |goal| %>
        <li class="progress-week-goal">
          <div class="progress-history__header">
            <strong><%= goal.name %></strong>
            <span><%= goal.completed_count %>/<%= goal.target_count %></span>
          </div>
          <% if goal.notes.present? %>
            <p class="progress-empty"><%= goal.notes %></p>
          <% end %>
          <div class="progress-week-goal__bar" role="progressbar" aria-label="<%= goal.name %>" aria-valuemin="0" aria-valuemax="<%= goal.target_count %>" aria-valuenow="<%= [goal.completed_count, goal.target_count].min %>" aria-valuetext="<%= goal.completed_count %> de <%= goal.target_count %> realizados">
            <span style="width: <%= goal.progress_percent %>%;"></span>
          </div>
          <small class="progress-empty"><%= goal.completed_count >= goal.target_count ? "Meta cumprida" : "Cada ação conta" %></small>
        </li>
      <% end %>
    </ul>
    <% if @weekly_health_plan.weekly_health_goals.empty? %>
      <p class="progress-empty">Nenhuma Meta nesta semana. Use “Editar Metas” para adicionar.</p>
    <% end %>
  </article>
