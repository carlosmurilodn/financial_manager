<article id="resumo-da-semana" class="app-panel progress-panel">
  <div class="progress-panel__header">
    <span class="material-symbols-rounded">insights</span>
    <div>
      <p class="app-page__eyebrow">Indicadores · segunda a domingo</p>
      <h2>Resumo da semana</h2>
    </div>
  </div>
  <p class="progress-empty"><%= @week_start.strftime("%d/%m/%Y") %> a <%= (@week_start + 6.days).strftime("%d/%m/%Y") %></p>

  <div class="progress-indicators progress-indicators--summary">
    <div class="progress-indicator">
      <span class="material-symbols-rounded">monitor_weight</span>
      <strong>Corpo</strong>
      <% if @weekly_average_weight %>
        <span class="progress-indicator__value"><%= number_with_precision(@weekly_average_weight, precision: 2, separator: ",") %> kg</span>
        <small>Média dos pesos registrados na semana · <%= pluralize(@weekly_weight_count, "medição", "medições") %>.</small>
      <% else %>
        <span class="progress-indicator__value">Sem registros</span>
        <small>Nenhuma medição de peso nesta semana.</small>
      <% end %>
    </div>

    <div class="progress-indicator">
      <span class="material-symbols-rounded">workspace_premium</span>
      <strong>Vitórias</strong>
      <% if @weekly_wins_count.positive? %>
        <span class="progress-indicator__value"><%= pluralize(@weekly_wins_count, "conquista", "conquistas") %></span>
        <small>Total de vitórias registradas na semana.</small>
      <% else %>
        <span class="progress-indicator__value">Sem registros</span>
        <small>Nenhuma vitória registrada nesta semana.</small>
      <% end %>
    </div>
  </div>

  <div class="progress-indicators">
    <div class="progress-indicator">
      <span class="material-symbols-rounded">task_alt</span>
      <strong>Rotina</strong>
      <% if @weekly_health_plan.persisted? && @weekly_health_plan.weekly_health_goals.any? %>
        <ul class="progress-indicator__goals">
          <% @weekly_health_plan.weekly_health_goals.each do |goal| %>
            <li>
              <span><%= goal.name %></span>
              <strong><%= goal.completed_count %>/<%= goal.target_count %></strong>
            </li>
          <% end %>
        </ul>
        <small>Realizado/planejado em cada meta da semana.</small>
      <% else %>
        <span class="progress-indicator__value">Sem registros</span>
        <small>Nenhuma meta salva nesta semana.</small>
      <% end %>
    </div>
  </div>
</article>
