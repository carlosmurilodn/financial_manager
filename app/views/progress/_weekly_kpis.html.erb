<% [
  ["green", "Metas Cumpridas", "task_alt", "#{@completed_weekly_goals_count} / #{@saved_weekly_goals.size}"],
  ["yellow", "Dias Com Diário", "edit_note", "#{@self_knowledge_week.days.size} / 7"],
  ["purple", "Revisão Semanal", "event_note", @self_knowledge_reflection ? "Registrada" : "Sem registro"]
].each do |color, label, icon, value| %>
  <article class="self-knowledge-hero-kpi self-knowledge-hero-kpi--<%= color %>">
    <span class="material-symbols-rounded" aria-hidden="true"><%= icon %></span>
    <div><p><%= label %></p><strong><%= value %></strong></div>
  </article>
<% end %>
