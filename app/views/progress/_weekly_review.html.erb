<article class="app-panel progress-panel progress-week-fixed-panel">
  <div class="progress-history__header">
    <div class="progress-panel__header">
      <span class="material-symbols-rounded">edit_note</span>
      <div>
        <p class="app-page__eyebrow">Revisão · segunda a domingo</p>
        <h2>Perguntas da semana</h2>
      </div>
    </div>
    <%= link_to @weekly_health_review ? "Editar revisão" : "Responder revisão", edit_weekly_health_review_path(@week_start.iso8601), class: "app-btn app-btn--outline", data: { turbo_frame: "_top" } %>
  </div>

  <p class="progress-review-status" role="status">
    <% if @weekly_health_review&.complete? %>
      Revisão preenchida · 5/5 respostas
    <% elsif @weekly_health_review %>
      Em andamento · <%= @weekly_health_review.answered_count %>/5 respostas
    <% else %>
      Revisão pendente
    <% end %>
  </p>

  <div class="progress-week-scroll" tabindex="0" role="region" aria-label="Respostas da revisão semanal">
  <ol class="progress-review progress-review--answers">
    <% WeeklyHealthReview::QUESTIONS.each do |attribute, question| %>
      <li>
        <strong><%= question %></strong>
        <% answer = @weekly_health_review&.public_send(attribute) %>
        <p class="progress-review-answer"><%= answer.presence || "Ainda sem resposta." %></p>
      </li>
    <% end %>
  </ol>
  </div>
</article>
