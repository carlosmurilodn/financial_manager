<%= turbo_frame_tag "progress-weekly-goals", class: "progress-weekly-frame" do %>
<section class="app-page progress-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-page__hero-top--progress">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">monitoring</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Rotina e saude</p>
          <h1 class="app-page__title">Progresso</h1>
          <p class="app-page__description">
            Acompanhe o que foi planejado, realizado e registrado na semana selecionada.
          </p>
        </div>
      </div>

      <%= render "weekly_period" %>
    </div>
  </div>

  <%= render "weekly_progress" %>

  <div id="historico-peso" class="progress-weight-overview">
  <article class="app-panel progress-panel progress-weight-panel">
    <div class="progress-history__header">
      <div class="progress-panel__header">
        <span class="material-symbols-rounded">monitor_weight</span>
        <div>
          <p class="app-page__eyebrow">Referência geral</p>
          <h2>Histórico de peso</h2>
        </div>
      </div>
      <%= link_to "Registrar peso", new_weight_entry_path, class: "app-btn app-btn--primary", data: { turbo: false } %>
    </div>

    <div class="progress-weight-scroll" tabindex="0" role="region" aria-label="Registros de peso">
    <% if @weight_entries.any? %>
      <ul class="progress-history">
        <% @weight_entries.each do |entry| %>
          <li class="progress-history__row">
            <div class="progress-history__measurement">
              <time datetime="<%= entry.measured_on.iso8601 %>"><%= entry.measured_on.strftime("%d/%m/%Y") %></time>
              <strong><%= number_with_precision(entry.weight_kg, precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg</strong>
            </div>
            <div class="progress-history__actions">
              <%= link_to "Editar", edit_weight_entry_path(entry), class: "app-btn app-btn--outline", data: { turbo: false }, aria: { label: "Editar medição de #{entry.measured_on.strftime('%d/%m/%Y')}" } %>
              <%= button_to "Excluir", weight_entry_path(entry), method: :delete, class: "app-btn app-btn--outline", form: { data: { turbo_confirm: "Excluir a medição de #{entry.measured_on.strftime('%d/%m/%Y')}?" } }, aria: { label: "Excluir medição de #{entry.measured_on.strftime('%d/%m/%Y')}" } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="progress-empty">Nenhum peso registrado ainda. Comece quando fizer sentido para você; consistência vale mais que uma medição isolada.</p>
    <% end %>
    </div>
  </article>
  <%= render "weight_chart" %>
  </div>




</section>

<% end %>
