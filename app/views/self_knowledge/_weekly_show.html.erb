<%= render 'self_knowledge/week_summary', summary: summary, compact: true, routine_satisfaction: record.routine_satisfaction %>
<% icons = { recurring_patterns: 'repeat', what_helped: 'wb_sunny', what_drained: 'battery_alert', thought_patterns: 'psychology', avoidance_and_control: 'pause_circle', self_discovery: 'person_search', weekly_needs: 'volunteer_activism', control_reflection: 'tune', proud_of: 'workspace_premium', weekly_learning: 'school', keep_doing: 'task_alt', change_next_week: 'edit_note' } %>
<% Health::SelfKnowledgeContent::STAGES.each do |title, fields| %>
  <% visible = fields.reject { |field| field == :next_small_step }.select { |field| field == :weekly_needs ? record.weekly_needs.any? || record.weekly_needs_notes.present? : record.public_send(field).present? } %>
  <% next if visible.empty? %>
  <section>
    <div class="diary-show__section-heading"><h2><%= title %></h2></div>
    <div class="diary-show__reflections diary-show__weekly-reflections">
      <% visible.each do |field| %>
        <article class="diary-show__reflection">
          <div class="diary-show__reflection-heading">
            <span class="material-symbols-rounded" aria-hidden="true"><%= icons.fetch(field, 'chat_bubble') %></span>
            <h3><%= Health::SelfKnowledgeContent::WEEKLY.fetch(field).first %></h3>
          </div>
          <% if field == :weekly_needs %>
            <% if record.weekly_needs.any? %><div class="diary-show__needs"><% record.weekly_needs.each do |need| %><span><%= need %></span><% end %></div><% end %>
            <% if record.weekly_needs_notes.present? %><div class="diary-show__text"><%= simple_format(record.weekly_needs_notes) %></div><% end %>
          <% else %>
            <div class="diary-show__text"><%= simple_format(record.public_send(field)) %></div>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
<% if record.next_small_step.present? %>
  <article class="diary-show__reflection diary-show__next-step">
    <div class="diary-show__reflection-heading"><span class="material-symbols-rounded" aria-hidden="true">flag</span><h2>Meu próximo pequeno passo</h2></div>
    <div class="diary-show__text"><%= simple_format(record.next_small_step) %></div>
  </article>
<% end %>
