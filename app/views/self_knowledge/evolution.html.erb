<section class="app-page health-index-page self-knowledge-page self-knowledge-evolution">
  <%= render "self_knowledge/header" %>
  <div class="app-panel evolution-toolbar">
    <%= form_with url: self_knowledge_evolution_path, method: :get, local: true, class: "evolution-period-form" do |f| %>
      <%= f.label :period, 'Período' %>
      <%= f.select :period, [['30 dias', '30'], ['3 meses', '90'], ['6 meses', '180'], ['1 ano', '365'], ['Tudo', 'all']], { selected: @evolution.period }, class: 'app-form-select', onchange: 'this.form.requestSubmit()' %>
    <% end %>
    <div class="evolution-registration-pill"><span class="material-symbols-rounded" aria-hidden="true">calendar_month</span><strong><%= @evolution.days.size %></strong><span><%= @evolution.days.size == 1 ? 'dia registrado' : 'dias registrados' %></span></div>
  </div>
  <section class="app-panel evolution-insight-card evolution-insight-card--steps">
    <div class="evolution-card-heading"><span class="material-symbols-rounded" aria-hidden="true">flag</span><h2>Passos que eu escolhi</h2></div>
    <div class="evolution-steps">
      <% @evolution.steps.each do |week| %>
        <article class="evolution-step">
          <%= link_to "#{week.week_start.strftime('%d/%m/%Y')} a #{(week.week_start + 6.days).strftime('%d/%m/%Y')}", health_weekly_reflection_path(week), class: 'evolution-step__week' %>
          <div class="evolution-step__text"><%= simple_format(week.next_small_step) %></div>
        </article>
      <% end %>
    </div>
    <% if @evolution.steps.empty? %><p class="evolution-empty">Ainda não há próximos passos neste período.</p><% end %>
  </section>
  <div class="evolution-chart-grid">
    <% Health::SelfKnowledgeContent::METRICS.each_with_index do |(field, (label, *)), index| %>
      <section class="app-panel evolution-chart-card self-knowledge-hero-kpi--<%= %w[green yellow purple][index] %>">
        <div class="evolution-card-heading"><span class="material-symbols-rounded" aria-hidden="true"><%= %w[sentiment_satisfied bolt psychology][index] %></span><h2><%= label %></h2></div>
        <p class="evolution-card-description"><%= field == :tension ? 'Quanto maior, maior a tensão.' : 'Registros diários na escala de 1 a 5.' %></p>
        <% points = @evolution.days.map { |day| { date: day.entry_date.iso8601, value: day.public_send(field) } } %>
        <% if points.any? { |point| point[:value] } %>
          <%= tag.div class: 'self-knowledge-chart', data: { controller: 'self-knowledge-chart', self_knowledge_chart_points_value: points.to_json, self_knowledge_chart_label_value: label } do %><canvas data-self-knowledge-chart-target="canvas" role="img" aria-label="Evolução de <%= label %>, de 1 a 5"></canvas><% end %>
          <details class="evolution-chart-details"><summary>Ver valores registrados</summary><ul><% points.each do |point| %><li><span><%= Date.iso8601(point[:date]).strftime('%d/%m/%Y') %></span><strong><%= point[:value] ? "#{point[:value]} / 5" : 'Sem registro' %></strong></li><% end %></ul></details>
        <% else %><p class="evolution-empty">Nenhum indicador preenchido neste período.</p><% end %>
      </section>
    <% end %>
  </div>
  <div class="evolution-insight-grid">
    <section class="app-panel evolution-insight-card">
      <div class="evolution-card-heading"><span class="material-symbols-rounded" aria-hidden="true">volunteer_activism</span><h2>Do que tenho precisado?</h2></div>
      <p class="evolution-card-description">Necessidades selecionadas em diários e revisões do período.</p>
      <div class="evolution-needs"><% @evolution.needs.each do |name, count| %><span><%= name %><strong><%= count %></strong></span><% end %></div>
      <% if @evolution.needs.empty? %><p class="evolution-empty">Sem necessidades selecionadas.</p><% end %>
    </section>
    <section class="app-panel evolution-insight-card">
      <div class="evolution-card-heading"><span class="material-symbols-rounded" aria-hidden="true">event_available</span><h2>Satisfação com a rotina</h2></div>
      <p class="evolution-card-description">Avaliações registradas nas revisões semanais.</p>
      <div class="evolution-routines">
        <% @evolution.routines.each do |week| %>
          <div class="evolution-routine">
            <%= link_to "#{week.week_start.strftime('%d/%m/%Y')} a #{(week.week_start + 6.days).strftime('%d/%m/%Y')}", health_weekly_reflection_path(week) %>
            <span class="evolution-routine__scale" aria-hidden="true"><% 5.times do |index| %><span class="<%= 'is-filled' if index < week.routine_satisfaction %>"></span><% end %></span>
            <strong><%= week.routine_satisfaction %> / 5</strong>
          </div>
        <% end %>
      </div>
      <% if @evolution.routines.empty? %><p class="evolution-empty">Sem avaliações semanais neste período.</p><% end %>
    </section>
  </div>
  <% if @evolution.legacy_weeks.any? %><section class="app-panel"><h2>Histórico semanal anterior</h2><p>Registros semanais legados, apresentados separadamente das médias e gráficos diários.</p><% @evolution.legacy_weeks.each do |week| %><details><summary>Registro semanal legado · <%= week.week_start.strftime('%d/%m/%Y') %></summary><div class="diary-metrics"><% HealthDiaryContent::METRICS.each do |field, label| %><% if week.public_send(field).present? %><p><strong><%= label %>:</strong> <%= week.public_send(field) %> / 5</p><% end %><% end %></div><% if week.notes.present? %><%= simple_format(week.notes) %><% end %>
      <% original = @evolution.legacy_originals[week.legacy_wellbeing_id] %>
      <% if original %><details><summary>Registro original de bem-estar</summary><% WeeklyWellbeing::METRICS.each do |field, label| %><p><strong><%= label %>:</strong> <%= original.public_send(field) %> / 5</p><% end %><%= simple_format(original.notes) %></details><% end %>
    </details><% end %></section><% end %>
</section>
