<% record = @record %>
<% week_summary = Health::SelfKnowledgeWeek.new(current_user, record.week_start) if weekly? %>
<section class="app-page diary-show diary-show--reading self-knowledge-page <%= weekly? ? 'diary-show--weekly' : 'diary-show--daily' %>">
  <header class="diary-show__hero">
    <div class="diary-show__identity">
      <span class="diary-show__hero-icon material-symbols-rounded" aria-hidden="true"><%= weekly? ? 'event_note' : 'auto_stories' %></span>
      <div><p class="app-page__eyebrow">Saúde Mental · <%= weekly? ? 'Revisão Semanal' : 'Acompanhamento Diário' %></p><h1><%= record_title(record) %></h1></div>
    </div>
    <div class="diary-show__actions">
      <%= link_to collection_path, class: 'diary-entry-card__action' do %><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>Voltar<% end %>
      <%= link_to edit_record_path(record), class: 'diary-entry-card__action' do %><span class="material-symbols-rounded" aria-hidden="true">edit</span>Editar<% end %>
      <%= button_to record_path(record), method: :delete, form: { data: { turbo_confirm: 'Excluir este registro?' } }, class: 'diary-entry-card__action diary-entry-card__action--danger' do %><span class="material-symbols-rounded" aria-hidden="true">delete</span>Excluir<% end %>
    </div>
      <% Health::SelfKnowledgeContent::METRICS.each_with_index do |(field, (label, _, descriptions)), index| %>
        <% value = weekly? ? week_summary.averages.fetch(field)[:mean] : record.public_send(field) %>
        <article class="self-knowledge-hero-kpi self-knowledge-hero-kpi--<%= mental_score_color(value, field: field) %> diary-show__reading-kpi">
          <span class="material-symbols-rounded" aria-hidden="true"><%= %w[sentiment_satisfied bolt psychology][index] %></span>
          <div>
            <p><%= weekly? ? { mood: 'Humor Médio', energy: 'Energia Média', tension: 'Tensão / Ansiedade Média' }.fetch(field) : label %></p>
            <strong><%= value ? "#{weekly? ? number_with_precision(value, precision: 1, separator: ',') : value} / 5" : 'Sem registro' %></strong>
            <% if weekly? %>
              <small><%= pluralize(week_summary.averages.fetch(field)[:count], 'resposta diária', 'respostas diárias') %></small>
            <% elsif value %><small><%= descriptions[value - 1] %></small><% end %>
          </div>
        </article>
      <% end %>
  </header>
  <% if weekly? %>
    <%= render 'self_knowledge/weekly_show', record: record, summary: week_summary %>
  <% else %>
    <%= render 'self_knowledge/daily_show', record: record %>
  <% end %>
  <% if !weekly? && record.legacy_content.present? %><%= render 'self_knowledge/legacy', record: record %><% end %>
</section>
