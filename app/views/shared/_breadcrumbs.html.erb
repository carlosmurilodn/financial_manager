<nav class="app-breadcrumbs" aria-label="Breadcrumb">
  <ol class="app-breadcrumbs__list">
    <li class="app-breadcrumbs__item">
      <%= link_to root_path, class: "app-breadcrumbs__link" do %>
        <span class="material-symbols-rounded">home</span>
      <% end %>
    </li>
    <% breadcrumbs.each_with_index do |crumb, index| %>
      <li class="app-breadcrumbs__separator">
        <span class="material-symbols-rounded">chevron_right</span>
      </li>
      <li class="app-breadcrumbs__item">
        <% if index == breadcrumbs.size - 1 %>
          <span class="app-breadcrumbs__current"><%= crumb[:label] %></span>
        <% else %>
          <%= link_to crumb[:path], class: "app-breadcrumbs__link" do %>
            <%= crumb[:label] %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
