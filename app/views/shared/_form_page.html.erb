<section class="app-page app-form-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top app-form-page__hero">
      <div class="app-page__hero-unit app-page__hero-copy">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded"><%= icon %></span>
        </span>
        <div>
          <p class="app-page__eyebrow"><%= eyebrow %></p>
          <h1 class="app-page__title"><%= title %></h1>
          <% if local_assigns[:description].present? %>
            <p class="app-page__description"><%= description %></p>
          <% end %>
        </div>
      </div>

      <%= link_to back_path, class: "app-show-back-link" do %>
        <span class="material-symbols-rounded">arrow_back</span>
        Voltar
      <% end %>
    </div>
  </div>

  <div class="app-panel app-form-page__panel">
    <% if resource.errors.any? %>
      <div class="app-alert app-alert--danger app-form-page__errors" role="alert">
        <strong>Revise os campos abaixo:</strong>
        <ul>
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= yield %>
  </div>
</section>
