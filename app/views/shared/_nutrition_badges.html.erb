<div class="nutrition-recipe-result__nutrients">
  <% { calories: ["Calorias", "kcal"], carbohydrates: ["Carboidratos", "g"], proteins: ["Proteínas", "g"], fats: ["Gorduras", "g"] }.each do |field, (label, unit)| %>
    <% partial = !values[field].nil? && local_assigns.fetch(:incomplete_fields, []).include?(field) %>
    <span class="nutrition-recipe-result__badge nutrition-recipe-result__badge--<%= field %>"<% if partial %> title="Total parcial: alguns alimentos não informam este nutriente."<% end %>><%= label %>: <%= taco_nutrient_value(values[field]) %><%= " #{unit}" unless values[field].nil? %><%= " (parcial)" if partial %></span>
  <% end %>
</div>
