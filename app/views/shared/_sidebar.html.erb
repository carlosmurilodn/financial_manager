<aside id="sidebar-wrapper" class="app-sidebar <%= 'app-sidebar--health' if health_section? %>">
  <div class="app-sidebar__inner">
    <div class="app-sidebar__brand">
      <div class="app-sidebar__brand-main">
        <%= link_to root_path, class: "app-sidebar__logo", title: "Voltar ao Gerenciador Pessoal", aria: { label: "Voltar à escolha de áreas do Gerenciador Pessoal" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded" aria-hidden="true"><%= app_section_brand[:icon] %></span>
        <% end %>
        <div class="app-sidebar__brand-copy">
          <span class="sidebar-title"><%= app_section_brand[:title] %></span>
        </div>
      </div>

      <%= button_to destroy_user_session_path,
                    method: :delete,
                    class: "app-sidebar__brand-logout",
                    form: { class: "app-sidebar__brand-logout-form" },
                    title: "Sair",
                    aria: { label: "Sair" } do %>
        <span class="material-symbols-rounded">logout</span>
      <% end %>
    </div>

    <nav class="app-sidebar__nav">
      <% if personal_development_section? %>
        <%= link_to personal_development_path, class: "app-nav-link #{'active-menu' if controller_name == 'personal_development'}", id: "link-personal-development", title: "Visão Geral", aria: { label: "Visão Geral" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">space_dashboard</span>
          <span class="link-text">Visão Geral</span>
        <% end %>
        <%= link_to writing_books_path, class: "app-nav-link #{'active-menu' if controller_name.in?(%w[writing_books writing_chapters writing_characters writing_relationships writing_plots writing_conflicts writing_locations writing_organizations writing_universe_rules writing_scenes writing_notes writing_narrative_contexts writing_timeline_events writing_publications writing_statistics])}", title: "Estúdio de Escrita", aria: { label: "Estúdio de Escrita", current: controller_name.in?(%w[writing_books writing_chapters writing_characters writing_relationships writing_plots writing_conflicts writing_locations writing_organizations writing_universe_rules writing_scenes writing_notes writing_narrative_contexts writing_timeline_events writing_publications writing_statistics]) ? "page" : nil } do %>
          <span class="material-symbols-rounded app-nav-link__icon" aria-hidden="true">auto_stories</span>
          <span class="link-text">Estúdio de Escrita</span>
        <% end %>
        <%= button_to writing_backup_path, method: :post, class: "app-nav-link", title: "Backup", aria: { label: "Backup completo do banco de dados" }, form: { class: "app-nav-form", data: { turbo: false } } do %>
          <span class="material-symbols-rounded app-nav-link__icon" aria-hidden="true">backup</span>
          <span class="link-text">Backup</span>
        <% end %>
      <% elsif health_section? %>
        <div class="app-health-mobile-links">
          <% [
            [progress_path, :progress, "Progresso", "monitoring"],
            [weight_entries_path, :weight, "Balança", "monitor_weight"],
            [health_nutrition_path, :nutrition, "Alimentação", "restaurant"],
            [health_exercises_path, :exercise, "Exercícios", "fitness_center"],
            [health_journal_entries_path, :daily, "Acompanhamento Diário", "edit_note"],
            [health_weekly_reflections_path, :weekly, "Revisão Semanal", "event_note"],
            [self_knowledge_path, :self_knowledge, "Autoconhecimento", "psychology_alt"],
            [health_profile_path, :profile, "Perfil de Saúde", "person"],
            [health_weight_goals_path, :milestones, "Marcos e Metas", "flag"],
            [muscle_groups_path, :muscle_groups, "Grupos Musculares", "accessibility_new"],
            [strength_exercise_catalogs_path, :strength_exercises, "Exercícios de Musculação", "fitness_center"]
          ].each do |path, section, label, icon| %>
            <% if path.present? %>
              <%= link_to path, class: "app-nav-link #{'active-menu' if health_nav_active?(section)}", title: label, aria: { label: label, current: health_nav_active?(section) ? "page" : nil }, data: { turbo: false } do %>
                <span class="material-symbols-rounded app-nav-link__icon" aria-hidden="true"><%= icon %></span>
                <span class="link-text"><%= label %></span>
              <% end %>
            <% else %>
              <span class="app-nav-link app-nav-link--disabled" title="<%= label %>" aria-label="<%= label %>" aria-disabled="true">
                <span class="material-symbols-rounded app-nav-link__icon" aria-hidden="true"><%= icon %></span>
                <span class="link-text"><%= label %></span>
              </span>
            <% end %>
          <% end %>
        </div>
        <%= link_to progress_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:progress)}", id: "link-progress", title: "Progresso", aria: { label: "Progresso" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">monitoring</span>
          <span class="link-text">Progresso</span>
        <% end %>

        <details class="app-nav-group" <%= "open" if %i[weight nutrition exercise goals].any? { |item| health_nav_active?(item) } %>>
          <summary class="app-nav-link" title="Saúde Física">
            <span class="material-symbols-rounded app-nav-link__icon">fitness_center</span>
            <span class="link-text">Saúde Física</span>
            <span class="material-symbols-rounded app-nav-group__arrow" aria-hidden="true">expand_more</span>
          </summary>
          <div class="app-nav-group__items">
            <%= link_to weight_entries_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:weight)}", id: "link-health-weight", title: "Balança", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">monitor_weight</span>
              <span class="link-text">Balança</span>
            <% end %>
            <%= link_to health_nutrition_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:nutrition)}", title: "Alimentação", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">restaurant</span>
              <span class="link-text">Alimentação</span>
            <% end %>
            <%= link_to health_exercises_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:exercise)}", title: "Exercícios", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">fitness_center</span>
              <span class="link-text">Exercícios</span>
            <% end %>
          </div>
        </details>

        <details class="app-nav-group" <%= "open" if health_nav_active?(:beyond_scale) %>>
          <summary class="app-nav-link" title="Saúde Mental">
            <span class="material-symbols-rounded app-nav-link__icon">psychology</span>
            <span class="link-text">Saúde Mental</span>
            <span class="material-symbols-rounded app-nav-group__arrow" aria-hidden="true">expand_more</span>
          </summary>
          <div class="app-nav-group__items">
            <%= link_to health_journal_entries_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:daily)}", id: "link-health-daily", title: "Acompanhamento Diário", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">edit_note</span>
              <span class="link-text">Acompanhamento Diário</span>
            <% end %>
            <%= link_to health_weekly_reflections_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:weekly)}", id: "link-health-weekly", title: "Revisão Semanal", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">event_note</span>
              <span class="link-text">Revisão Semanal</span>
            <% end %>
            <%= link_to self_knowledge_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:self_knowledge)}", id: "link-health-beyond-scale", title: "Autoconhecimento", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">psychology_alt</span>
              <span class="link-text">Autoconhecimento</span>
            <% end %>
          </div>
        </details>

        <details class="app-nav-group" <%= "open" if health_nav_active?(:basic_registries) %>>
          <summary class="app-nav-link" title="Cadastros Básicos">
            <span class="material-symbols-rounded app-nav-link__icon">inventory_2</span>
            <span class="link-text">Cadastros Básicos</span>
            <span class="material-symbols-rounded app-nav-group__arrow" aria-hidden="true">expand_more</span>
          </summary>
          <div class="app-nav-group__items">
            <%= link_to health_profile_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:profile)}", id: "link-health-profile", title: "Perfil de Saúde", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">person</span>
              <span class="link-text">Perfil de Saúde</span>
            <% end %>
            <%= link_to health_weight_goals_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:milestones)}", id: "link-health-milestones", title: "Marcos e Metas", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">flag</span>
              <span class="link-text">Marcos e Metas</span>
            <% end %>
            <%= link_to muscle_groups_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:muscle_groups)}", id: "link-health-muscle-groups", title: "Grupos Musculares", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">accessibility_new</span>
              <span class="link-text">Grupos Musculares</span>
            <% end %>
            <%= link_to strength_exercise_catalogs_path, class: "app-nav-link #{'active-menu' if health_nav_active?(:strength_exercises)}", id: "link-health-strength-exercises", title: "Exercícios de Musculação", data: { turbo: false } do %>
              <span class="material-symbols-rounded app-nav-link__icon">fitness_center</span>
              <span class="link-text">Exercícios de Musculação</span>
            <% end %>
          </div>
        </details>

      <% else %>
        <%= link_to financial_dashboard_path, class: "app-nav-link #{'active-menu' if current_page?(financial_dashboard_path)}", id: "link-home", title: "Dashboard", aria: { label: "Dashboard" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">space_dashboard</span>
          <span class="link-text">Dashboard</span>
        <% end %>

        <%= link_to expenses_path, class: "app-nav-link #{'active-menu' if current_page?(expenses_path)}", id: "link-expenses", title: "Despesas", aria: { label: "Despesas" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">receipt_long</span>
          <span class="link-text">Despesas</span>
        <% end %>

        <%= link_to incomes_path, class: "app-nav-link #{'active-menu' if current_page?(incomes_path)}", id: "link-incomes", title: "Receitas", aria: { label: "Receitas" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">payments</span>
          <span class="link-text">Receitas</span>
        <% end %>

        <%= link_to cards_path, class: "app-nav-link #{'active-menu' if current_page?(cards_path)}", id: "link-cards", title: "Cartões", aria: { label: "Cartões" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">credit_card</span>
          <span class="link-text">Cartoes</span>
        <% end %>

        <%= link_to categories_path, class: "app-nav-link #{'active-menu' if current_page?(categories_path)}", id: "link-categories", title: "Categorias", aria: { label: "Categorias" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">category</span>
          <span class="link-text">Categorias</span>
        <% end %>

        <%= link_to financial_goals_path, class: "app-nav-link #{'active-menu' if current_page?(financial_goals_path)}", id: "link-financial-goals", title: "Objetivos", aria: { label: "Objetivos" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">flag</span>
          <span class="link-text">Objetivos</span>
        <% end %>

        <!-- Calculadora ocultada temporariamente. -->

        <%= link_to reports_path, class: "app-nav-link #{'active-menu' if current_page?(reports_path)}", id: "link-reports", title: "Relatórios", aria: { label: "Relatórios" }, data: { turbo: false } do %>
          <span class="material-symbols-rounded app-nav-link__icon">insert_chart</span>
          <span class="link-text">Relatorios</span>
        <% end %>
      <% end %>

      <button id="themeToggleMobile" class="app-nav-link app-nav-link--theme app-theme-toggle-mobile" type="button" aria-label="Temas: alternar tema">
        <span class="material-symbols-rounded app-nav-link__icon app-theme-toggle-mobile__icon">devices</span>
        <span class="link-text app-theme-toggle-mobile__label">Sistema</span>
      </button>

      <%= button_to destroy_user_session_path, method: :delete, class: "app-nav-link app-nav-link--logout", title: "Sair", aria: { label: "Sair" }, form: { class: "app-nav-form" } do %>
        <span class="material-symbols-rounded app-nav-link__icon">logout</span>
        <span class="link-text">Sair</span>
      <% end %>
    </nav>

    <div class="app-sidebar__footer">
      <div class="app-sidebar__utilities">
        <button id="themeToggle" class="app-theme-toggle" type="button" aria-label="Alternar tema">
          <span class="material-symbols-rounded app-theme-toggle__icon">palette</span>
          <span class="app-theme-toggle__copy">
            <strong class="link-text app-theme-toggle__label">Tema atual</strong>
            <small class="link-text app-theme-toggle__meta">Trocar tema</small>
          </span>
        </button>
      </div>

      <%# <section class="app-sidebar__weather">
        <div class="app-sidebar__weather-header">
          <span>Goiania</span>
        </div>
        <div id="current-time" class="app-sidebar__time"></div>
        <div id="weather-info"></div>
      </section> %>
    </div>
  </div>
</aside>

<script>
  const APP_THEMES = [
    { id: "system", label: "Sistema", icon: "devices" },
    { id: "fincan", label: "Claro", icon: "lightbulb" },
    { id: "night", label: "Dark", icon: "dark_mode" }
  ];

  const APP_THEME_MEDIA = window.matchMedia("(prefers-color-scheme: dark)");
  const APP_MOBILE_MEDIA = window.matchMedia("(max-width: 991px)");

  function resolveTheme(themeId) {
    return themeId === "system" ? (APP_THEME_MEDIA.matches ? "night" : "fincan") : themeId;
  }

  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");
    const seconds = String(now.getSeconds()).padStart(2, "0");
    const timeMarkup = `<span class="app-sidebar__time-main">${hours}:${minutes}</span><span class="app-sidebar__time-seconds">:${seconds}</span>`;

    ["current-time", "dashboard-current-time", "app-page-current-time"].forEach((id) => {
      const timeNode = document.getElementById(id);
      if (timeNode) timeNode.innerHTML = timeMarkup;
    });
  }

  function formatWeatherDescription(description) {
    return description
      .split(" ")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");
  }

  async function loadWeather() {
    const weatherNodes = ["weather-info", "dashboard-weather-info", "app-page-weather-info"]
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    if (!weatherNodes.length) return;

    const apiKey = "d56b203c35ee12ffb7de5bf2aaf5eccd";
    const city = "Aparecida de Goiânia,BR";
    const url = `https://api.openweathermap.org/data/2.5/forecast?q=${encodeURIComponent(city)}&units=metric&lang=pt_br&appid=${apiKey}`;

    try {
      const res = await fetch(url);
      const data = await res.json();
      if (!data.list) throw new Error("Sem dados");

      const todayForecasts = data.list.slice(0, 8);
      const tempNow = data.list[0].main.temp.toFixed(0);
      const tempMin = Math.min(...todayForecasts.map((forecast) => forecast.main.temp_min)).toFixed(0);
      const tempMax = Math.max(...todayForecasts.map((forecast) => forecast.main.temp_max)).toFixed(0);
      const todayIcon = data.list[0].weather[0].icon;
      const todayDesc = data.list[0].weather[0].description;
      const formattedTodayDesc = formatWeatherDescription(todayDesc);
      const todayWeatherId = data.list[0].weather[0].id;

      const dashboardWeatherClass = (() => {
        const isNight = todayIcon.endsWith("n");

        if (todayWeatherId >= 200 && todayWeatherId < 300) return "today-weather--storm";
        if (todayWeatherId >= 300 && todayWeatherId < 400) return isNight ? "today-weather--drizzle-night" : "today-weather--drizzle";
        if (todayWeatherId >= 500 && todayWeatherId < 600) return isNight ? "today-weather--rain-night" : "today-weather--rain";
        if (todayWeatherId >= 600 && todayWeatherId < 700) return "today-weather--snow";
        if (todayWeatherId >= 700 && todayWeatherId < 800) return "today-weather--mist";
        if (todayWeatherId === 800) return isNight ? "today-weather--clear-night" : "today-weather--clear";
        if (todayWeatherId > 800) return isNight ? "today-weather--cloudy-night" : "today-weather--clouds";

        return isNight ? "today-weather--clear-night" : "today-weather--clear";
      })();

      const sidebarWeatherMarkup = `
        <div class="today-weather">
          <div class="today-weather__current">
            <img src="https://openweathermap.org/img/wn/${todayIcon}@2x.png" alt="${todayDesc}" width="34" height="34">
            <strong>${tempNow}°C</strong>
          </div>
          <div class="today-weather__details">
            <span>${formattedTodayDesc}</span>
            <small>Min ${tempMin}°C · Max ${tempMax}°C</small>
          </div>
        </div>
      `;

      const dashboardWeatherMarkup = `
        <div class="today-weather today-weather--dashboard ${dashboardWeatherClass}">
          <span class="today-weather__description">${formattedTodayDesc}</span>
          <div class="today-weather__current">
            <img src="https://openweathermap.org/img/wn/${todayIcon}@2x.png" alt="${todayDesc}" width="68" height="68">
            <div class="today-weather__current-copy">
              <strong>${tempNow}°C</strong>
              <span class="today-weather__city">Goiania</span>
            </div>
          </div>
          <div class="today-weather__range">
            <small>Min ${tempMin}°C e Max ${tempMax}°C</small>
          </div>
        </div>
      `;

      const appPageWeatherMarkup = `
        <div class="today-weather today-weather--compact ${dashboardWeatherClass}">
          <div class="today-weather__current">
            <img src="https://openweathermap.org/img/wn/${todayIcon}@2x.png" alt="${todayDesc}" width="30" height="30">
            <strong>${tempNow}°C</strong>
          </div>
          <div class="today-weather__details">
            <span>${formattedTodayDesc}</span>
          </div>
        </div>
      `;

      const sidebarNode = document.getElementById("weather-info");
      const dashboardNode = document.getElementById("dashboard-weather-info");
      const appPageNode = document.getElementById("app-page-weather-info");

      if (sidebarNode) sidebarNode.innerHTML = sidebarWeatherMarkup;
      if (dashboardNode) dashboardNode.innerHTML = dashboardWeatherMarkup;
      if (appPageNode) appPageNode.innerHTML = appPageWeatherMarkup;
    } catch (error) {
      weatherNodes.forEach((node) => {
        node.textContent = "Clima indisponivel";
      });
    }
  }

  function updateSidebar() {
    const wrapper = document.getElementById("wrapper");
    const sidebar = document.getElementById("sidebar-wrapper");
    if (!wrapper || !sidebar) return;

    const title = sidebar.querySelector(".app-sidebar__brand-copy");
    const linkTexts = sidebar.querySelectorAll(".link-text");
    const collapsed = localStorage.getItem("sidebar-collapsed") === "true";

    wrapper.classList.toggle("collapsed", collapsed);
    linkTexts.forEach((element) => {
      element.style.display = collapsed ? "none" : "inline";
    });

    if (title) title.style.display = collapsed ? "none" : "flex";
    updateSidebarGroups();
  }

  function updateSidebarGroups() {
    document.querySelectorAll(".app-nav-group").forEach((group) => {
      if (APP_MOBILE_MEDIA.matches) {
        if (group.dataset.desktopOpen === undefined) group.dataset.desktopOpen = String(group.open);
        group.open = true;
      } else if (group.dataset.desktopOpen !== undefined) {
        group.open = group.dataset.desktopOpen === "true";
        delete group.dataset.desktopOpen;
      }
    });
  }

  function getCurrentTheme() {
    const savedPreference = localStorage.getItem("app-theme-preference");
    if (APP_THEMES.some((theme) => theme.id === savedPreference)) return savedPreference;

    const legacyTheme = localStorage.getItem("app-theme");
    if (APP_MOBILE_MEDIA.matches) return "system";
    return APP_THEMES.some((theme) => theme.id === legacyTheme) && legacyTheme !== "system" ? legacyTheme : "fincan";
  }

  function applyTheme(themeId) {
    const activeTheme = resolveTheme(themeId);
    document.documentElement.dataset.theme = activeTheme;
    localStorage.setItem("app-theme-preference", themeId);
    localStorage.setItem("app-theme", activeTheme);
    updateThemeToggle();
  }

  function refreshSystemTheme() {
    if (getCurrentTheme() !== "system") return;

    const activeTheme = resolveTheme("system");
    document.documentElement.dataset.theme = activeTheme;
    localStorage.setItem("app-theme", activeTheme);
    updateThemeToggle();
  }

  function updateThemeToggle() {
    const toggles = [document.getElementById("themeToggle"), document.getElementById("themeToggleMobile")].filter(Boolean);
    if (!toggles.length) return;

    const currentTheme = APP_THEMES.find((theme) => theme.id === getCurrentTheme()) || APP_THEMES[0];
    const nextTheme = APP_THEMES[(APP_THEMES.findIndex((theme) => theme.id === currentTheme.id) + 1) % APP_THEMES.length];
    const activeThemeLabel = resolveTheme(currentTheme.id) === "night" ? "Dark" : "Claro";

    toggles.forEach((toggle) => {
      const icon = toggle.querySelector(".app-theme-toggle__icon, .app-theme-toggle-mobile__icon");
      const label = toggle.querySelector(".app-theme-toggle__label, .app-theme-toggle-mobile__label");
      const meta = toggle.querySelector(".app-theme-toggle__meta");

      if (icon) icon.textContent = currentTheme.icon;
      if (label) label.textContent = currentTheme.label;
      if (meta) meta.textContent = currentTheme.id === "system" ? `Usando ${activeThemeLabel}` : `Trocar para ${nextTheme.label}`;

      const prefix = toggle.id === "themeToggleMobile" ? "Temas. " : "";
      toggle.setAttribute("title", `${prefix}Tema atual: ${currentTheme.label}. Clique para alternar.`);
      toggle.setAttribute("aria-label", `${prefix}Tema atual: ${currentTheme.label}. Clique para alternar para ${nextTheme.label}.`);
    });
  }

  document.addEventListener("turbo:load", () => {
    updateClock();
    updateSidebar();
    updateThemeToggle();
    loadWeather();

    [document.getElementById("themeToggle"), document.getElementById("themeToggleMobile")].filter(Boolean).forEach((themeToggle) => {
      if (themeToggle.dataset.bound === "true") return;

      themeToggle.dataset.bound = "true";
      themeToggle.addEventListener("click", () => {
        const currentTheme = getCurrentTheme();
        const currentIndex = APP_THEMES.findIndex((theme) => theme.id === currentTheme);
        const nextTheme = APP_THEMES[(currentIndex + 1) % APP_THEMES.length];
        applyTheme(nextTheme.id);
      });
    });
  });

  APP_THEME_MEDIA.addEventListener("change", refreshSystemTheme);
  APP_MOBILE_MEDIA.addEventListener("change", updateSidebarGroups);

  setInterval(updateClock, 1000);
</script>
