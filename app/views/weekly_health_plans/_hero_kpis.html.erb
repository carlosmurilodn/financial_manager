<div id="weekly-health-plans-hero-kpis" class="app-weekly-health-plans-hero-kpis">
  <div class="stat-card stat-card--warning">
    <div class="stat-card__icon">
      <span class="material-symbols-rounded">task_alt</span>
    </div>
    <div>
      <span class="stat-card__label">Última semana</span>
      <strong class="stat-card__value">
        <%= @latest_weekly_health_plan ? pluralize(@latest_weekly_health_plan.weekly_health_goals.size, "meta", "metas") : "Sem registro" %>
      </strong>
      <small><%= @latest_weekly_health_plan ? @latest_weekly_health_plan.week_start.strftime("%d/%m/%Y") : "Cadastre suas metas semanais." %></small>
    </div>
  </div>

  <div class="stat-card stat-card--primary">
    <div class="stat-card__icon">
      <span class="material-symbols-rounded">format_list_numbered</span>
    </div>
    <div>
      <span class="stat-card__label">Registros filtrados</span>
      <strong class="stat-card__value"><%= @filtered_count || 0 %></strong>
      <small><%= @week_from_label.present? ? "Desde #{@week_from_label}" : "Todas as semanas" %></small>
    </div>
  </div>
</div>
