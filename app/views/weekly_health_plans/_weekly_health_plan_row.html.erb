<% goals = weekly_health_plan.weekly_health_goals.to_a.sort_by { |goal| goal.name.to_s.parameterize } %>
<% total_target = goals.sum(&:target_count) %>
<% total_completed = goals.sum(&:completed_count) %>
<% progress = total_target.positive? ? (total_completed.to_f / total_target * 100).round : 0 %>

<div
  id="<%= dom_id(weekly_health_plan) %>"
  class="health-card weekly-health-plan-card <%= progress >= 100 ? "health-card--success" : "health-card--pending" %>"
  style="--health-card-accent: #5c6df2;"
>
  <div class="health-card__content">
    <div class="health-card__summary">
      <div class="health-card__identity-block">
        <div class="health-card__identity-main">
          <div class="health-card__icon-wrapper">
            <span class="material-symbols-rounded health-card__icon">task_alt</span>
          </div>

          <div class="health-card__description">
            <h3 class="health-card__title">Semana de <%= weekly_health_plan.week_start.strftime("%d/%m/%Y") %> a <%= weekly_health_plan.week_end.strftime("%d/%m/%Y") %></h3>
          </div>
        </div>
      </div>

      <div class="health-card__progress">
        <strong class="health-card__amount"><%= progress %>%</strong>
        <span class="health-card__status <%= progress >= 100 ? "health-card__status--success" : "health-card__status--pending" %>">
          <span class="material-symbols-rounded health-card__status-icon"><%= progress >= 100 ? "check" : "schedule" %></span>
          <span><%= progress >= 100 ? "Cumprida" : "Em andamento" %></span>
        </span>
      </div>

      <div class="health-card__information">
        <span class="health-card__meta-item">
          <span class="material-symbols-rounded">format_list_numbered</span>
          <span><small>Total</small><strong><%= total_completed %>/<%= total_target %></strong></span>
        </span>
      </div>

      <div class="health-card__actions">
        <% unless local_assigns[:show_details] %>
          <%= link_to weekly_health_plan_path(weekly_health_plan.week_start.iso8601), class: "health-card__action", data: { turbo: false }, aria: { label: "Ver semana de #{weekly_health_plan.week_start.strftime('%d/%m/%Y')}" } do %>
            <span class="material-symbols-rounded">visibility</span>
            <span>Ver semana</span>
          <% end %>
        <% end %>
        <%= link_to edit_weekly_health_plan_path(weekly_health_plan.week_start.iso8601),
                    class: "health-card__action",
                    title: "Editar metas",
                    aria: { label: "Editar metas da semana de #{weekly_health_plan.week_start.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="health-card__action-label">Editar</span>
        <% end %>

        <%= link_to weekly_health_plan_path(weekly_health_plan.week_start.iso8601),
                    data: { turbo_method: :delete, turbo_confirm: "Excluir as metas da semana de #{weekly_health_plan.week_start.strftime("%d/%m/%Y")}?" },
                    class: "health-card__action health-card__action--danger",
                    title: "Excluir metas",
                    aria: { label: "Excluir metas da semana de #{weekly_health_plan.week_start.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">delete</span>
          <span class="health-card__action-label">Excluir</span>
        <% end %>
      </div>
    </div>

    <% if local_assigns[:show_details] %>
      <%= render "daily_goals", weekly_health_plan: weekly_health_plan %>
      <%= render "daily_calorie_entries/week", week_start: weekly_health_plan.week_start, entries_by_date: @daily_calorie_entries_by_date, health_profile: @health_profile %>
    <% end %>
  </div>
</div>
