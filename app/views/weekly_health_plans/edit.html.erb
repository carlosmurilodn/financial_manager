<%= render layout: "shared/form_page", locals: {
  resource: @weekly_health_plan,
  title: "Metas da semana",
  eyebrow: "Progresso · segunda a domingo",
  description: "#{@week_start.strftime('%d/%m/%Y')} a #{@weekly_health_plan.week_end.strftime('%d/%m/%Y')}. Alterações valem apenas para esta semana.",
  icon: "task_alt",
  back_path: weekly_health_plans_path
} do %>
  <%= render "form",
             weekly_health_plan: @weekly_health_plan,
             form_url: weekly_health_plan_path(@week_start.iso8601),
             form_method: :patch %>
<% end %>
