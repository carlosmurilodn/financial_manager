<%= form_with model: weekly_health_review, url: form_url, method: form_method, local: true, html: { class: "app-form-page__form", data: { turbo: false } } do |f| %>
  <p class="progress-empty">Você pode salvar respostas parciais e completar depois. Cada resposta aceita até 2.000 caracteres.</p>

  <div class="progress-review-form" data-health-review-form>
    <div>
      <%= label_tag :review_kind, "Tipo de registro" %>
      <%= select_tag :review_kind,
            options_for_select(WeeklyHealthReview::REVIEW_KINDS.map { |value, label| [label, value] }, @weekly_health_review.review_kind || "daily"),
            class: "app-form-select",
            data: { health_review_kind: true } %>
      <small>Diário registra um dia específico. Semanal registra uma semana de segunda a domingo.</small>
    </div>

    <% if local_assigns[:show_week_select] %>
      <div data-health-review-daily-field>
        <%= label_tag :review_date, "Dia do registro" %>
        <%= text_field_tag :review_date,
              (@selected_date || Date.current).strftime("%d/%m/%Y"),
              class: "app-form-control custom-date",
              autocomplete: "off",
              placeholder: "Selecione a data",
              required: true %>
      </div>

      <div data-health-review-weekly-field>
        <%= label_tag :week_number, "Semana do lançamento" %>
        <%= select_tag :week_number,
              options_for_select(@week_options, @selected_week_number),
              class: "app-form-select",
              required: true %>
        <small>As semanas seguem o padrão de segunda a domingo.</small>
      </div>
    <% end %>

    <% weekly_health_review.questions.each do |attribute, question| %>
      <div>
        <%= f.label attribute, question, data: { health_review_question: true, daily: WeeklyHealthReview::DAILY_QUESTIONS.fetch(attribute), weekly: WeeklyHealthReview::QUESTIONS.fetch(attribute) } %>
        <%= f.text_area attribute, class: "app-form-control", rows: 4, maxlength: 2000 %>
      </div>
    <% end %>
  </div>

  <div class="app-form-page__actions">
    <%= link_to "Cancelar", weekly_health_reviews_path, class: "app-btn app-btn--outline" %>
    <%= f.submit "Salvar perguntas #{weekly_health_review.daily? ? 'do dia' : 'da semana'}", class: "app-btn app-btn--primary", data: { health_review_submit: true } %>
  </div>
<% end %>
