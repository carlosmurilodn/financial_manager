<div id="weekly-health-reviews-hero-kpis" class="app-weekly-health-reviews-hero-kpis">
  <div class="stat-card stat-card--warning">
    <div class="stat-card__icon">
      <span class="material-symbols-rounded">edit_note</span>
    </div>
    <div>
      <span class="stat-card__label">Última resposta</span>
      <strong class="stat-card__value">
        <%= @latest_weekly_health_review ? "#{@latest_weekly_health_review.answered_count}/#{WeeklyHealthReview::QUESTIONS.size}" : "Sem resposta" %>
      </strong>
      <small><%= @latest_weekly_health_review ? @latest_weekly_health_review.week_start.strftime("%d/%m/%Y") : "Responda sua primeira semana." %></small>
    </div>
  </div>

  <div class="stat-card stat-card--primary">
    <div class="stat-card__icon">
      <span class="material-symbols-rounded">format_list_numbered</span>
    </div>
    <div>
      <span class="stat-card__label">Registros filtrados</span>
      <strong class="stat-card__value"><%= @filtered_count || 0 %></strong>
      <small><%= @week_from_label.present? ? "Desde #{@week_from_label}" : "Todas as semanas" %></small>
    </div>
  </div>
</div>
