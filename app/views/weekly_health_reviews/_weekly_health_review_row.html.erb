<div
  id="<%= dom_id(weekly_health_review) %>"
  class="health-review-card"
>
  <div class="health-review-card__content">
    <%= link_to weekly_health_review_path(weekly_health_review.week_start.iso8601, kind: weekly_health_review.review_kind),
                class: "health-review-card__main",
                aria: { label: "Ver perguntas de #{weekly_health_review.period_title}" } do %>
      <div class="health-review-card__identity">
        <span class="health-review-card__icon">
          <span class="material-symbols-rounded">edit_note</span>
        </span>
        <h3 class="health-review-card__title"><%= weekly_health_review.period_title %></h3>
      </div>

      <strong class="health-review-card__amount"><%= weekly_health_review.answered_count %>/<%= WeeklyHealthReview::QUESTIONS.size %></strong>

      <span class="health-review-card__status <%= weekly_health_review.complete? ? "health-review-card__status--success" : "health-review-card__status--pending" %>">
        <span class="material-symbols-rounded"><%= weekly_health_review.complete? ? "check" : "schedule" %></span>
        <span><%= weekly_health_review.complete? ? "Completa" : "Parcial" %></span>
      </span>
    <% end %>

    <div class="health-review-card__actions">
      <%= link_to edit_weekly_health_review_path(weekly_health_review.week_start.iso8601, kind: weekly_health_review.review_kind),
                  class: "health-review-card__action",
                  title: "Editar perguntas",
                  aria: { label: "Editar perguntas de #{weekly_health_review.period_title}" } do %>
        <span class="material-symbols-rounded">edit</span>
        <span>Editar</span>
      <% end %>

      <%= link_to weekly_health_review_path(weekly_health_review.week_start.iso8601, kind: weekly_health_review.review_kind),
                  data: { turbo_method: :delete, turbo_confirm: "Excluir as respostas de #{weekly_health_review.period_title}?" },
                  class: "health-review-card__action health-review-card__action--danger",
                  title: "Excluir perguntas",
                  aria: { label: "Excluir perguntas de #{weekly_health_review.period_title}" } do %>
        <span class="material-symbols-rounded">delete</span>
        <span>Excluir</span>
      <% end %>
    </div>
  </div>
</div>
