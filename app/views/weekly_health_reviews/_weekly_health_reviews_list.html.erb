<div id="weekly-health-reviews-table">
  <% if @weekly_health_reviews.any? %>
    <div class="expenses-cards-list" id="weekly-health-reviews-list">
      <% @weekly_health_reviews.each do |weekly_health_review| %>
        <%= render partial: "weekly_health_review_row", locals: { weekly_health_review: weekly_health_review } %>
      <% end %>
    </div>
  <% else %>
    <div class="dashboard-empty-state">
      <span class="material-symbols-rounded">edit_note</span>
      <strong>Nenhuma resposta encontrada</strong>
      <small>Ajuste os filtros ou responda as perguntas da semana.</small>
    </div>
  <% end %>

  <%= render "shared/pagination",
             current_page: @current_page,
             total_pages: @total_pages,
             base_params: request.query_parameters.except(:page),
             aria_label: "Paginacao de perguntas da semana" %>
</div>
