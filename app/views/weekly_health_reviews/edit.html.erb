<%= render layout: "shared/form_page", locals: {
  resource: @weekly_health_review,
  title: "Perguntas da semana",
  eyebrow: "Perguntas · segunda a domingo",
  description: "#{@weekly_health_review.period_title}. Reflita sobre sua rotina sem julgamento.",
  icon: "edit_note",
  back_path: weekly_health_reviews_path
} do %>
  <%= render "form",
             weekly_health_review: @weekly_health_review,
             form_url: weekly_health_review_path(@week_start.iso8601),
             form_method: :patch,
             show_week_select: true %>
<% end %>
