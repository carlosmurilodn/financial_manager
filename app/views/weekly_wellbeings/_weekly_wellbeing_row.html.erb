<div
  id="<%= dom_id(weekly_wellbeing) %>"
  class="weekly-wellbeing-card "
  style="--health-card-accent: #5c6df2;"
>
  <div class="weekly-wellbeing-card__content">
    <div class="weekly-wellbeing-card__identity-block">
      <div class="weekly-wellbeing-card__identity-main">
        <div class="weekly-wellbeing-card__icon-wrapper">
          <span class="material-symbols-rounded weekly-wellbeing-card__icon">insights</span>
        </div>

        <div class="weekly-wellbeing-card__description-link">
          <h3 class="weekly-wellbeing-card__title">Semana de <%= weekly_wellbeing.week_start.strftime("%d/%m/%Y") %></h3>
        </div>
      </div>

      <div class="weekly-wellbeing-card__amount-area">
        <strong class="weekly-wellbeing-card__amount">
          <%= ((weekly_wellbeing.energy + weekly_wellbeing.mood + weekly_wellbeing.routine_satisfaction) / 3.0).round(1).to_s.tr(".", ",") %>/5
        </strong>

        <span class="weekly-wellbeing-card__status weekly-wellbeing-card__status--success">
          <span class="material-symbols-rounded weekly-wellbeing-card__status-state-icon">check</span>
          <span class="weekly-wellbeing-card__status-label">Registrado</span>
          <span class="material-symbols-rounded weekly-wellbeing-card__status-mobile-icon" aria-hidden="true">psychology</span>
        </span>
      </div>
    </div>

    <div class="weekly-wellbeing-card__badges">
      <% WeeklyWellbeing::METRICS.each do |attribute, label| %>
        <span class="weekly-wellbeing-card__pill"><%= label %>: <%= weekly_wellbeing.public_send(attribute) %>/5</span>
      <% end %>
    </div>

    <div class="weekly-wellbeing-card__footer">
      <div class="weekly-wellbeing-card__information">
        <span class="weekly-wellbeing-card__meta-item">
          <span class="material-symbols-rounded">calendar_month</span>
          <span><small>Semana</small><strong><%= weekly_wellbeing.week_start.strftime("%d/%m/%Y") %> a <%= (weekly_wellbeing.week_start + 6.days).strftime("%d/%m/%Y") %></strong></span>
        </span>

        <span class="weekly-wellbeing-card__meta-item">
          <span class="material-symbols-rounded">notes</span>
          <span><small>Observação</small><strong><%= weekly_wellbeing.notes.present? ? "Preenchida" : "Sem observação" %></strong></span>
        </span>
      </div>

      <div class="weekly-wellbeing-card__actions">
        <%= link_to edit_weekly_wellbeing_path(weekly_wellbeing.week_start.iso8601),
                    class: "weekly-wellbeing-card__action",
                    title: "Editar bem-estar",
                    aria: { label: "Editar bem-estar da semana de #{weekly_wellbeing.week_start.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="weekly-wellbeing-card__action-label">Editar</span>
        <% end %>

        <%= link_to weekly_wellbeing_path(weekly_wellbeing.week_start.iso8601),
                    data: { turbo_method: :delete, turbo_confirm: "Excluir o registro da semana de #{weekly_wellbeing.week_start.strftime("%d/%m/%Y")}?" },
                    class: "weekly-wellbeing-card__action weekly-wellbeing-card__action--danger",
                    title: "Excluir bem-estar",
                    aria: { label: "Excluir bem-estar da semana de #{weekly_wellbeing.week_start.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">delete</span>
          <span class="weekly-wellbeing-card__action-label">Excluir</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
