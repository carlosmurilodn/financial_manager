<div id="weekly-wellbeings-table">
  <% if @weekly_wellbeings.any? %>
    <div class="weekly-wellbeing-list" id="weekly-wellbeings-list">
      <% @weekly_wellbeings.each do |weekly_wellbeing| %>
        <%= render partial: "weekly_wellbeing_row", locals: { weekly_wellbeing: weekly_wellbeing } %>
      <% end %>
    </div>
  <% else %>
    <div class="dashboard-empty-state">
      <span class="material-symbols-rounded">insights</span>
      <strong>Nenhum registro encontrado</strong>
      <small>Ajuste os filtros ou registre seu bem-estar da semana.</small>
    </div>
  <% end %>

  <%= render "shared/pagination",
             current_page: @current_page,
             total_pages: @total_pages,
             base_params: request.query_parameters.except(:page),
             aria_label: "Paginacao de progresso alem da balanca" %>
</div>
