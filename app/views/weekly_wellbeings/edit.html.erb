<%= render layout: "shared/form_page", locals: {
  resource: @weekly_wellbeing,
  title: "Bem-estar da semana",
  eyebrow: "Progresso · segunda a domingo",
  description: "#{@week_start.strftime('%d/%m/%Y')} a #{(@week_start + 6.days).strftime('%d/%m/%Y')}. Registre como você percebeu sua semana.",
  icon: "psychology",
  back_path: weekly_wellbeings_path
} do %>
  <%= render "form",
             weekly_wellbeing: @weekly_wellbeing,
             form_url: weekly_wellbeing_path(@week_start.iso8601),
             form_method: :patch,
             show_week_select: false %>
<% end %>
