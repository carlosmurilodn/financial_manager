<div
  id="<%= dom_id(weight_entry) %>"
  class="expense-card expense-card--expense"
  style="--expense-category-color: #5c6df2;"
>
  <div class="expense-card__content">
    <div class="expense-card__identity-block">
      <div class="expense-card__identity-main">
        <div class="expense-card__icon-wrapper">
          <span class="material-symbols-rounded expense-card__icon">monitor_weight</span>
        </div>

        <div class="expense-card__description-link">
          <h3 class="expense-card__title">Medição de peso</h3>
        </div>
      </div>

      <div class="expense-card__amount-area">
        <strong class="expense-card__amount">
          <%= number_with_precision(weight_entry.weight_kg, precision: 2, strip_insignificant_zeros: true, separator: ",") %> kg
        </strong>

        <span class="expense-card__status expense-card__status--paid">
          <span class="material-symbols-rounded expense-card__status-state-icon">check</span>
          <span class="expense-card__status-label">Registrado</span>
          <span class="material-symbols-rounded expense-card__status-mobile-icon" aria-hidden="true">monitor_weight</span>
        </span>
      </div>
    </div>

    <div class="expense-card__badges">
      <span class="expense-card__pill">Saúde</span>
      <span class="expense-card__pill">Histórico de Peso</span>
    </div>

    <div class="expense-card__footer">
      <div class="expense-card__information">
        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">calendar_month</span>
          <span><small>Data</small><strong><%= weight_entry.measured_on.strftime("%d/%m/%Y") %></strong></span>
        </span>

        <span class="expense-card__meta-item">
          <span class="material-symbols-rounded">event_available</span>
          <span><small>Cadastro</small><strong><%= weight_entry.created_at.strftime("%d/%m/%Y") %></strong></span>
        </span>
      </div>

      <div class="expense-card__actions">
        <%= link_to edit_weight_entry_path(weight_entry),
                    class: "expense-card__action",
                    title: "Editar medição",
                    aria: { label: "Editar medição de #{weight_entry.measured_on.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">edit</span>
          <span class="expense-card__action-label">Editar</span>
        <% end %>

        <%= link_to weight_entry_path(weight_entry),
                    data: { turbo_method: :delete, turbo_confirm: "Excluir a medição de #{weight_entry.measured_on.strftime("%d/%m/%Y")}?" },
                    class: "expense-card__action expense-card__action--danger",
                    title: "Excluir medição",
                    aria: { label: "Excluir medição de #{weight_entry.measured_on.strftime("%d/%m/%Y")}" } do %>
          <span class="material-symbols-rounded">delete</span>
          <span class="expense-card__action-label">Excluir</span>
        <% end %>
      </div>
    </div>
  </div>
</div>
