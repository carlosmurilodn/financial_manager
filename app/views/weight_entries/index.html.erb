<section class="app-page health-index-page self-knowledge-page">
  <div class="app-page__hero">
    <div class="app-page__hero-top self-knowledge-section-hero app-page__hero-top--weight-entries">
      <div class="app-page__hero-unit app-page__hero-copy self-knowledge-section-hero__heading">
        <span class="app-page__hero-icon">
          <span class="material-symbols-rounded">monitor_weight</span>
        </span>
        <div>
          <p class="app-page__eyebrow">Saúde Física</p>
          <h1 class="app-page__title">Balança</h1>
        </div>
      </div>

      <div class="app-page__hero-unit self-knowledge-page-actions">
        <%= link_to new_weight_entry_path, class: "app-btn app-btn--primary", data: { turbo: false } do %>
          <span>
            <span class="material-symbols-rounded">add</span>
          </span>
          <span>
            <strong>Novo Peso</strong>
          </span>
        <% end %>
      </div>

      <div class="app-page__hero-kpis">
        <%= render "hero_kpis" %>
      </div>
    </div>

    <%# <p class="app-page__description">Registros de peso para acompanhar tendência, sem transformar uma medição isolada em julgamento.</p> %>
  </div>

  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: weight_entries_path, method: :get, local: true, class: "app-filter-form" do |f| %>
        <div class="health-index-filters">
          <div class="app-filter-field">
            <%= f.label :measured_from, "De" %>
            <%= f.date_field :measured_from, value: @measured_from_filter, class: "app-form-control", max: Date.current.iso8601 %>
          </div>

          <div class="app-filter-field">
            <%= f.label :measured_to, "Até" %>
            <%= f.date_field :measured_to, value: @measured_to_filter, class: "app-form-control", max: Date.current.iso8601 %>
          </div>
        </div>

        <div class="app-filter-actions">
          <%= f.button class: "app-btn app-btn--primary app-page__primary-btn" do %>
            <i class="bi bi-funnel me-1"></i> <%= t("buttons.filter") %>
          <% end %>

          <%= link_to clear_filters_weight_entries_path,
                      class: "app-btn app-btn--secondary app-page__secondary-btn",
                      data: { turbo_method: :delete } do %>
            <i class="bi bi-x-circle me-1"></i> Limpar Filtros
          <% end %>

          <%= render "shared/per_page_select" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="app-panel app-panel--table">
    <%= render "weight_entries_table" %>
  </div>
</section>
