<section class="app-page writing-studio">
  <div class="app-page__hero">
    <div class="app-page__hero-top">
      <div class="app-page__hero-copy">
        <span class="app-page__hero-icon"><span class="material-symbols-rounded" aria-hidden="true">auto_stories</span></span>
        <div><p class="app-page__eyebrow">Projetos</p><h1 class="app-page__title">Estúdio de Escrita</h1>
          <p class="app-page__description">Organize suas obras, desenvolva suas histórias e acompanhe sua jornada como escritor.</p></div>
      </div>
      <%= link_to "Novo Livro", new_writing_book_path, class: "app-btn app-btn--primary" %>
    </div>
    <div class="writing-metrics">
      <% [["Total de livros", @total_count], ["Em planejamento", @counts.fetch("planning", 0)], ["Em escrita", @counts.fetch("writing", 0)], ["Concluídos", @counts.fetch("completed", 0)]].each do |label, count| %>
        <div class="app-panel writing-metric"><span><%= label %></span><strong><%= count %></strong></div>
      <% end %>
    </div>
  </div>
  <div class="app-panel">
    <%= render "shared/filter_accordion" do %>
      <%= form_with url: writing_books_path, method: :get, class: "app-filter-form" do |f| %>
        <div class="writing-fields">
          <div><%= f.label :title, "Título" %><%= f.search_field :title, value: @title_filter, class: "app-form-control" %></div>
          <div><%= f.label :author, "Autor" %><%= f.search_field :author, value: @author_filter, class: "app-form-control" %></div>
          <div><%= f.label :genre, "Gênero" %><%= f.select :genre, options_for_select(WritingBook::GENRES.invert, @genre_filter), { include_blank: "Todos" }, class: "app-form-select" %></div>
          <div><%= f.label :status, "Situação" %><%= f.select :status, options_for_select(WritingBook::STATUSES.invert, @status_filter), { include_blank: "Todas" }, class: "app-form-select" %></div>
          <div><%= f.label :sort, "Ordenar por" %><%= f.select :sort, options_for_select([["Título", "title"], ["Data de criação", "created_at"], ["Última atualização", "updated_at"]], @sort), {}, class: "app-form-select" %></div>
          <div><%= f.label :direction, "Ordem" %><%= f.select :direction, options_for_select([["Crescente", "asc"], ["Decrescente", "desc"]], @direction), {}, class: "app-form-select" %></div>
        </div>
        <div class="app-filter-actions">
          <%= f.submit "Filtrar", class: "app-btn app-btn--primary" %>
          <%= link_to "Limpar Filtros", writing_books_path, class: "app-btn app-btn--secondary" %>
          <div class="app-per-page-control"><%= f.label :per_page, "Exibir" %><%= f.select :per_page, options_for_select(per_page_options, @per_page), {}, class: "app-form-select", onchange: "this.form.requestSubmit()" %><span>por página</span></div>
        </div>
      <% end %>
    <% end %>
  </div>
  <% if @total_count.zero? %>
    <div class="app-panel writing-empty"><span class="material-symbols-rounded" aria-hidden="true">auto_stories</span><h2>Sua biblioteca ainda está vazia.</h2>
      <p>Todas as grandes histórias começam com uma ideia. Que tal cadastrar seu primeiro livro?</p>
      <%= link_to "Criar primeiro livro", new_writing_book_path, class: "app-btn app-btn--primary" %></div>
  <% elsif @books.empty? %>
    <div class="app-panel writing-empty"><h2>Nenhum livro encontrado.</h2><p>Experimente outros termos ou limpe os filtros.</p><%= link_to "Limpar Filtros", writing_books_path, class: "app-btn app-btn--secondary" %></div>
  <% else %>
    <p><%= @filtered_count %> livro(s) encontrado(s)</p>
    <div class="writing-library">
      <% @books.each do |book| %>
        <%= link_to writing_book_path(book), class: "app-panel writing-book-card" do %>
          <%= render "cover", book: book %>
          <div class="writing-book-card__copy"><h2><%= book.title %></h2>
            <% if book.subtitle.present? %><p><%= book.subtitle %></p><% end %>
            <p><%= book.author.presence || "Autor não informado" %></p>
            <span><%= book.genre_label %></span><span class="writing-status writing-status--<%= book.status %>"><%= book.status_label %></span>
            <small>Atualizado em <%= l(book.updated_at.to_date) %></small>
          </div>
        <% end %>
      <% end %>
    </div>
    <%= render "shared/pagination", current_page: @current_page, total_pages: @total_pages, base_params: request.query_parameters %>
  <% end %>
</section>
