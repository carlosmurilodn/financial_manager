<section class="app-page writing-studio literary-editor-page" data-controller="narrative-panel" data-narrative-panel-url-value="<%= writing_context_path(@book, @chapter) %>" data-action="literary-editor:saved->narrative-panel#documentSaved">
  <% is_scene = @chapter.is_a?(WritingScene) %>
  <% document_label = is_scene ? "cena" : "capítulo" %>
  <%= render "shared/breadcrumbs", items: [["Projetos", personal_development_path], ["Estúdio de Escrita", writing_books_path], [@book.title, writing_book_path(@book)], ["Editor Literário", nil]] %>
  <div class="literary-writing-layout">
  <%= form_with model: [@book, @chapter], local: true, html: {
    id: "literary-document-form", class: "literary-editor", data: { controller: "literary-editor", literary_editor_label_value: document_label, action: "submit->literary-editor#save", turbo: false }
  } do |f| %>
    <div class="app-panel literary-editor-heading">
      <div class="literary-editor-heading__title">
        <p class="app-page__eyebrow"><%= @book.title %> · Editor Literário</p>
        <%= f.label :title, "Título #{document_label}", class: "visually-hidden" %>
        <%= f.text_field :title, required: true, maxlength: 200, class: "literary-chapter-title", placeholder: "Título #{document_label}", data: { literary_editor_target: "title", action: "input->literary-editor#updateDirty" } %>
      </div>
      <div class="literary-editor-actions">
        <button type="button" class="app-btn app-btn--secondary" aria-controls="literary-narrative-panel" aria-expanded="false" data-narrative-panel-target="toggle" data-action="narrative-panel#toggle"><%= writing_action_label("view_sidebar", "Painel Narrativo") %></button>
        <%= f.button writing_action_label("save", "Salvar #{document_label}"), type: :submit, class: "app-btn app-btn--primary", disabled: true, data: { literary_editor_target: "save" } %>
        <%= link_to writing_action_label("arrow_back", "Voltar ao livro"), writing_book_path(@book), class: "app-btn app-btn--outline" %>
        <%= link_to writing_action_label("download", "Exportar HTML"), @chapter.persisted? ? (is_scene ? export_writing_book_writing_scene_path(@book, @chapter) : export_writing_book_writing_chapter_path(@book, @chapter)) : "#", class: "app-btn app-btn--secondary", aria: { disabled: !@chapter.persisted? }, data: { literary_editor_target: "export", action: "click->literary-editor#export", turbo: false } %>
      </div>
    </div>
    <% if @chapter.errors.any? %>
      <div class="app-alert app-alert--danger" role="alert"><%= @chapter.errors.full_messages.join(". ") %></div>
    <% end %>
    <%= f.hidden_field :content, value: @chapter.content.to_json, data: { literary_editor_target: "content" } %>
    <%= f.hidden_field :writing_chapter_id if is_scene %>
    <%= f.hidden_field :lock_version, data: { literary_editor_target: "lockVersion" } %>
    <%= render "writing_chapters/toolbar", editor_controller: "literary-editor" %>
    <div class="literary-editor-desk"><div class="literary-editor-sheet" data-literary-editor-target="host"></div></div>
    <noscript><div class="app-alert app-alert--danger">Ative JavaScript para usar o Editor Literário. Nenhum conteúdo salvo será alterado.</div></noscript>
  <% end %>
  <%= render "narrative_panel" %>
  </div>
  <% if @chapter.persisted? && !is_scene %><%= render "scenes" %><% end %>
</section>
