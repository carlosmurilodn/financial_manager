<section class="app-panel writing-detail"><div class="writing-chapters__heading"><h2 class="writing-detail__title"><span class="material-symbols-rounded" aria-hidden="true">movie</span>Cenas</h2><%= link_to writing_action_label("add", "Nova cena"), new_writing_book_writing_scene_path(@book, writing_chapter_id: @chapter.id), class: "app-btn app-btn--primary" %></div>
  <% scenes = @chapter.writing_scenes.ordered %>
  <% if scenes.empty? %><p class="writing-muted">Nenhuma cena cadastrada. Cenas têm texto e elementos próprios, independentes do capítulo.</p><% else %><ul class="writing-scenes-list"><% scenes.each do |scene| %><li><%= link_to scene.title, writing_book_writing_scene_path(@book, scene), class: "writing-chapters__link" %><div class="writing-character-actions"><%= link_to writing_action_label("edit", "Editar cena"), edit_writing_book_writing_scene_path(@book, scene), class: "app-btn app-btn--secondary" %><%= button_to writing_action_label("delete", "Excluir cena"), writing_book_writing_scene_path(@book, scene), method: :delete, class: "app-btn app-btn--secondary writing-book-delete", form: { data: { turbo_confirm: "Excluir #{scene.title} e seu texto?" } } %></div></li><% end %></ul><% end %>
</section>
