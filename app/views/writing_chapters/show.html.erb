<section class="app-page writing-studio literary-editor-page" data-controller="narrative-panel" data-narrative-panel-url-value="<%= writing_context_path(@book, @chapter) %>">
  <%= render "shared/breadcrumbs", items: [["Projetos", personal_development_path], ["Estúdio de Escrita", writing_books_path], [@book.title, writing_book_path(@book)], [@chapter.title, nil]] %>
  <header class="app-panel writing-narrative-heading"><h1 class="app-page__title"><%= @chapter.title %></h1><div class="writing-character-actions"><%= link_to writing_action_label("edit", "Abrir editor"), edit_polymorphic_path([@book, @chapter]), class: "app-btn app-btn--primary" %><%= link_to writing_action_label("arrow_back", "Voltar ao livro"), writing_book_path(@book), class: "app-btn app-btn--outline" %><button type="button" class="app-btn app-btn--secondary" aria-controls="literary-narrative-panel" aria-expanded="false" data-narrative-panel-target="toggle" data-action="narrative-panel#toggle"><%= writing_action_label("view_sidebar", "Elementos Narrativos") %></button></div></header>
  <div class="literary-writing-layout"><article class="app-panel literary-manuscript"><%= literary_document_html(@chapter.content) %></article><%= render "narrative_panel" %></div>
  <% if @chapter.is_a?(WritingScene) %>
    <section class="app-panel"><h2>Mover cena</h2><%= form_with url: move_writing_book_writing_scene_path(@book, @chapter), method: :patch, class: "writing-scene-move" do |f| %><%= f.label :writing_chapter_id, "Capítulo de destino" %><%= f.collection_select :writing_chapter_id, @book.writing_chapters.ordered, :id, :title, { selected: @chapter.writing_chapter_id }, class: "app-form-select" %><%= f.button writing_action_label("drive_file_move", "Mover cena"), class: "app-btn app-btn--primary" %><% end %></section>
  <% else %><%= render "scenes" %><% end %>
</section>
