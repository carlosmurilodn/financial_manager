<% book = @book if @book.is_a?(WritingBook) && @book.persisted? %>
<% visible = local_assigns.fetch(:visible, false) %>
<section class="<%= visible ? 'app-panel writing-detail writing-github-schedule' : 'd-none' %>" <%= 'hidden' unless visible %> data-controller="github-schedule"
  data-github-schedule-url-value="<%= writing_github_sync_statuses_path(writing_book_id: book&.id) %>"
  data-action="literary-editor:saved@document->github-schedule#changed writing:saved@document->github-schedule#changed github-sync:finished@document->github-schedule#changed visibilitychange@document->github-schedule#returned focus@window->github-schedule#returned pageshow@window->github-schedule#returned">
  <h2 class="writing-detail__title"><span class="material-symbols-rounded" aria-hidden="true">cloud_sync</span>Sincronização GitHub</h2>
  <div data-github-schedule-target="states" role="status" aria-live="polite">Consultando sincronização…</div>
  <p class="writing-muted" data-github-schedule-target="message"></p>
  <p class="writing-muted">Alterações salvas são agrupadas em janelas de cinco minutos. Com o Estúdio fechado, o envio aguarda seu retorno.</p>
</section>
