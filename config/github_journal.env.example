# Configure no ambiente do servidor. Não salve tokens no Git.
# Token vazio reutiliza GITHUB_WRITING_TOKEN, que precisa acessar este repositório.
# Permissão necessária: Contents: Read and write em repositório privado.
GITHUB_JOURNAL_TOKEN=
GITHUB_JOURNAL_REPOSITORY=carlosmurilodn/acompanhamento-diario
GITHUB_JOURNAL_BRANCH=main
